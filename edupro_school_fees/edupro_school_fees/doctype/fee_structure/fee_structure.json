{
 "doctype": "DocType",
 "name": "Fee Structure",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "format:{academic_year}-{term}-{structure_name}",
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "structure_name", "fieldtype": "Data", "label": "Structure Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "academic_year", "fieldtype": "Link", "label": "Academic Year", "options": "Academic Year", "reqd": 1, "in_list_view": 1},
  {"fieldname": "term", "fieldtype": "Link", "label": "Term", "options": "Term", "reqd": 1, "in_list_view": 1},
  {"fieldname": "beneficiary_category", "fieldtype": "Link", "label": "Beneficiary Category", "options": "Beneficiary Category", "description": "Leave blank to apply to all categories"},
  {"fieldname": "items", "fieldtype": "Table", "label": "Fee Items", "options": "Fee Structure Item", "reqd": 1},
  {"fieldname": "total_amount", "fieldtype": "Currency", "label": "Total Amount", "read_only": 1},
  {"fieldname": "agm_minutes", "fieldtype": "Attach", "label": "AGM Minutes (required before approval)"},
  {"fieldname": "agm_minutes_hash", "fieldtype": "Data", "label": "AGM Minutes SHA-256", "read_only": 1, "description": "Computed from the attached file's own content -- changes if the file is ever swapped for a different one."},
  {"fieldname": "mopse_approval_letter", "fieldtype": "Attach", "label": "MoPSE Approval Letter (required before approval)"},
  {"fieldname": "mopse_approval_letter_hash", "fieldtype": "Data", "label": "MoPSE Approval Letter SHA-256", "read_only": 1},
  {"fieldname": "workflow_state", "fieldtype": "Select", "label": "Workflow State", "options": "Draft\nPending Approval\nApproved\nRejected", "default": "Draft", "read_only": 1, "in_list_view": 1},
  {"fieldname": "school_head_co_signed_by", "fieldtype": "Link", "label": "School Head Co-Signed By", "options": "User", "read_only": 1, "description": "Set only via co_sign_fee_structure(). Required, alongside the SDC co-sign, before this structure can reach Approved (spec 5.1: 'Approve Termly Fee Structures' is Co-Sign for both School Head and SDC Chair/Treasurer)."},
  {"fieldname": "school_head_co_signed_on", "fieldtype": "Datetime", "label": "School Head Co-Signed On", "read_only": 1},
  {"fieldname": "sdc_co_signed_by", "fieldtype": "Link", "label": "SDC Co-Signed By", "options": "User", "read_only": 1},
  {"fieldname": "sdc_co_signed_on", "fieldtype": "Datetime", "label": "SDC Co-Signed On", "read_only": 1},
  {"fieldname": "approved_by", "fieldtype": "Link", "label": "Approved By", "options": "User", "read_only": 1},
  {"fieldname": "approved_on", "fieldtype": "Datetime", "label": "Approved On", "read_only": 1},
  {"fieldname": "revision_of", "fieldtype": "Link", "label": "Revision Of", "options": "Fee Structure", "read_only": 1, "description": "Set only via create_revision() -- this Fee Structure supersedes the one named here once it is itself Approved."},
  {"fieldname": "superseded_by", "fieldtype": "Link", "label": "Superseded By", "options": "Fee Structure", "read_only": 1, "description": "Set automatically once a revision of this Fee Structure reaches Approved. An Approved structure with this set is historical, not current."}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1},
  {"role": "Fees Approver", "read": 1, "write": 1},
  {"role": "School Head", "read": 1, "write": 1},
  {"role": "SDC Chairperson/Treasurer", "read": 1, "write": 1},
  {"role": "District Education Auditor/Inspector", "read": 1},
  {"role": "Parent/Guardian", "read": 1},
  {"role": "Student", "read": 1}
 ]
}
