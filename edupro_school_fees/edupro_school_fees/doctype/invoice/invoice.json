{
 "doctype": "DocType",
 "name": "Invoice",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "autoname": "naming_series:",
 "sort_field": "posting_date",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "INV-.YYYY.-.#####", "default": "INV-.YYYY.-.#####"},
  {"fieldname": "student", "fieldtype": "Link", "label": "Student", "options": "Student", "reqd": 1, "in_list_view": 1},
  {"fieldname": "fee_structure", "fieldtype": "Link", "label": "Fee Structure", "options": "Fee Structure", "reqd": 1, "in_list_view": 1},
  {"fieldname": "academic_year", "fieldtype": "Link", "label": "Academic Year", "options": "Academic Year", "reqd": 1, "fetch_from": "fee_structure.academic_year"},
  {"fieldname": "term", "fieldtype": "Link", "label": "Term", "options": "Term", "reqd": 1, "fetch_from": "fee_structure.term"},
  {"fieldname": "posting_date", "fieldtype": "Date", "label": "Posting Date", "reqd": 1, "in_list_view": 1},
  {"fieldname": "due_date", "fieldtype": "Date", "label": "Due Date"},
  {"fieldname": "items", "fieldtype": "Table", "label": "Invoice Lines", "options": "Invoice Line", "reqd": 1},
  {"fieldname": "total_amount", "fieldtype": "Currency", "label": "Total Amount", "read_only": 1, "in_list_view": 1},
  {"fieldname": "outstanding_amount", "fieldtype": "Currency", "label": "Outstanding Amount", "read_only": 1, "in_list_view": 1, "allow_on_submit": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Unpaid\nPartly Paid\nPaid\nCancelled\nConsolidated", "default": "Unpaid", "read_only": 1, "in_list_view": 1, "allow_on_submit": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1, "submit": 1},
  {"role": "Fees Approver", "read": 1},
  {"role": "School Head", "read": 1},
  {"role": "District Education Auditor/Inspector", "read": 1},
  {"role": "Parent/Guardian", "read": 1},
  {"role": "Student", "read": 1}
 ]
}
