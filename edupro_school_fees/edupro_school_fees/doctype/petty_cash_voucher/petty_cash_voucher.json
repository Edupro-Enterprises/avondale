  {"fieldname": "petty_cash_float", "fieldtype": "Link", "label": "Petty Cash Float", "options": "Petty Cash Float", "reqd": 1, "in_list_view": 1},
  {"fieldname": "posting_date", "fieldtype": "Date", "label": "Posting Date", "reqd": 1, "in_list_view": 1},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Description", "reqd": 1},
  {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "reqd": 1, "in_list_view": 1},
  {"fieldname": "budget_line", "fieldtype": "Link", "label": "Budget Line", "options": "Budget Line", "reqd": 1, "description": "Expenditure classification -- only actual_spend is affected, and only once this voucher is reimbursed."},
  {"fieldname": "receipt_attachment", "fieldtype": "Attach", "label": "Receipt / Supporting Evidence"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending Reimbursement\nReimbursed", "default": "Pending Reimbursement", "read_only": 1, "in_list_view": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1, "submit": 1},
  {"role": "School Head", "read": 1},
  {"role": "District Education Auditor/Inspector", "read": 1}
 ]
}
