{
 "doctype": "DocType",
 "name": "Petty Cash Voucher",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "autoname": "naming_series:",
