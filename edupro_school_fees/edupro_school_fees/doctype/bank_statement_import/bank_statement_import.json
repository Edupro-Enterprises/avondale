{
 "doctype": "DocType",
 "name": "Bank Statement Import",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "naming_series:",
 "sort_field": "creation",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "BSI-.YYYY.-.#####", "default": "BSI-.YYYY.-.#####"},
  {"fieldname": "bank_account", "fieldtype": "Link", "label": "Bank / Mobile Money Account", "options": "Payment Method", "reqd": 1, "description": "The Payment Method whose account received these transactions -- used as the cash-side account of every Receipt this import posts."},
  {"fieldname": "statement_file", "fieldtype": "Attach", "label": "Statement File (CSV)", "reqd": 1},
  {"fieldname": "import_date", "fieldtype": "Date", "label": "Import Date", "default": "Today", "reqd": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nParsed\nCompleted", "default": "Draft", "read_only": 1, "in_list_view": 1},
  {"fieldname": "lines", "fieldtype": "Table", "label": "Statement Lines", "options": "Bank Statement Line"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "School Head", "read": 1},
  {"role": "District Education Auditor/Inspector", "read": 1}
 ]
}
