{
 "doctype": "DocType",
 "name": "Petty Cash Float",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "field:float_name",
 "sort_field": "modified",
 "sort_order": "ASC",
