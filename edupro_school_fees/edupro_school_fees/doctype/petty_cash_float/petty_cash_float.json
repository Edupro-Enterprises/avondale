  {"fieldname": "custodian", "fieldtype": "Link", "label": "Custodian", "options": "User", "reqd": 1, "in_list_view": 1},
  {"fieldname": "account", "fieldtype": "Link", "label": "Account", "options": "Account", "reqd": 1, "description": "The imprest cash account this float represents."},
  {"fieldname": "float_amount", "fieldtype": "Currency", "label": "Float Amount (Imprest Ceiling)", "reqd": 1},
  {"fieldname": "balance", "fieldtype": "Currency", "label": "Current Balance", "read_only": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nClosed", "default": "Active", "in_list_view": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1},
  {"role": "School Head", "read": 1},
  {"role": "District Education Auditor/Inspector", "read": 1}
 ]
}
