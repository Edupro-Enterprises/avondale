{
 "doctype": "DocType",
 "name": "Credit Note",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "naming_series:",
 "sort_field": "posting_date",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "CN-.YYYY.-.#####", "default": "CN-.YYYY.-.#####"},
  {"fieldname": "invoice", "fieldtype": "Link", "label": "Invoice", "options": "Invoice", "reqd": 1, "in_list_view": 1},
  {"fieldname": "student", "fieldtype": "Link", "label": "Student", "options": "Student", "read_only": 1, "fetch_from": "invoice.student", "in_list_view": 1},
  {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "reqd": 1, "in_list_view": 1, "description": "Cannot exceed the Invoice's current outstanding_amount."},
  {"fieldname": "reason", "fieldtype": "Small Text", "label": "Reason", "reqd": 1},
  {"fieldname": "posting_date", "fieldtype": "Date", "label": "Posting Date", "reqd": 1, "default": "Today", "in_list_view": 1},
  {"fieldname": "workflow_state", "fieldtype": "Select", "label": "Approval Status", "options": "Draft\nApproved\nRejected", "default": "Draft", "read_only": 1, "in_list_view": 1},
  {"fieldname": "approved_by", "fieldtype": "Link", "label": "Approved By", "options": "User", "read_only": 1, "description": "Set only once workflow_state reaches Approved, by a School Head -- the same 'authorized supervisor' role as Receipt reversal approval."},
  {"fieldname": "approved_on", "fieldtype": "Datetime", "label": "Approved On", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1},
  {"role": "School Head", "read": 1, "write": 1},
  {"role": "Fees Approver", "read": 1},
  {"role": "District Education Auditor/Inspector", "read": 1},
  {"role": "Parent/Guardian", "read": 1}
 ]
}
