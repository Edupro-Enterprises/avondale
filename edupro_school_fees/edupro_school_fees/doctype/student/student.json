{
 "doctype": "DocType",
 "name": "Student",
 "module": "Edupro School Fees",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "naming_series:",
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "STU-.YYYY.-.#####", "default": "STU-.YYYY.-.#####"},
  {"fieldname": "first_name", "fieldtype": "Data", "label": "First Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "last_name", "fieldtype": "Data", "label": "Last Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "date_of_birth", "fieldtype": "Date", "label": "Date of Birth"},
  {"fieldname": "gender", "fieldtype": "Select", "label": "Gender", "options": "\nFemale\nMale"},
  {"fieldname": "admission_date", "fieldtype": "Date", "label": "Admission Date", "reqd": 1},
  {"fieldname": "mopse_admission_number", "fieldtype": "Data", "label": "MoPSE Admission Number"},
  {"fieldname": "home_address", "fieldtype": "Small Text", "label": "Home Address"},
  {"fieldname": "academic_year", "fieldtype": "Link", "label": "Academic Year", "options": "Academic Year", "reqd": 1, "in_list_view": 1},
  {"fieldname": "current_term", "fieldtype": "Link", "label": "Current Term", "options": "Term"},
  {"fieldname": "grade", "fieldtype": "Data", "label": "Grade/Form", "description": "e.g. Grade 5, Form 2, Lower Six -- free text since the Zimbabwean ECD-to-A-Level structure varies by school phase."},
  {"fieldname": "beneficiary_category", "fieldtype": "Link", "label": "Beneficiary Category", "options": "Beneficiary Category", "reqd": 1, "in_list_view": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nSuspended\nWithdrawn\nTransferred Out\nDeceased\nGraduated", "default": "Active", "in_list_view": 1},
  {"fieldname": "user", "fieldtype": "Link", "label": "Portal User", "options": "User", "unique": 1, "description": "Links this student to their own portal login, if they have one. Left blank until an invitation is accepted (Phase 5.5)."},

  {"fieldname": "beam_section", "fieldtype": "Section Break", "label": "BEAM / Boarding / Transport"},
  {"fieldname": "vulnerability_classification", "fieldtype": "Data", "label": "Vulnerability Classification", "description": "For BEAM beneficiaries -- e.g. Orphan, Child-Headed Household, Disability."},
  {"fieldname": "district_social_welfare_reference", "fieldtype": "Data", "label": "District Social Welfare Reference"},
  {"fieldname": "is_boarder", "fieldtype": "Check", "label": "Boarder", "default": "0"},
  {"fieldname": "hostel_room", "fieldtype": "Data", "label": "Hostel / Dormitory Room"},
  {"fieldname": "bus_route", "fieldtype": "Data", "label": "Bus Route"},
  {"fieldname": "lunch_scheme", "fieldtype": "Select", "label": "Lunch Scheme", "options": "\nNone\nSchool Feeding Programme\nPacked Lunch\nPaid Meal Plan"},

  {"fieldname": "guardian_section", "fieldtype": "Section Break", "label": "Guardians & Legal Custody"},
  {"fieldname": "guardian", "fieldtype": "Link", "label": "Primary Guardian", "options": "Parent Guardian"},
  {"fieldname": "secondary_guardian", "fieldtype": "Link", "label": "Secondary Guardian", "options": "Parent Guardian"},
  {"fieldname": "court_order_on_file", "fieldtype": "Check", "label": "Court Order on File", "default": "0"},
  {"fieldname": "legal_guardian_designation", "fieldtype": "Small Text", "label": "Legal Guardian Designation / Notes"},

  {"fieldname": "medical_section", "fieldtype": "Section Break", "label": "Medical Profile"},
  {"fieldname": "blood_group", "fieldtype": "Select", "label": "Blood Group", "options": "\nO+\nO-\nA+\nA-\nB+\nB-\nAB+\nAB-\nUnknown"},
  {"fieldname": "allergies", "fieldtype": "Small Text", "label": "Allergies"},
  {"fieldname": "chronic_conditions", "fieldtype": "Small Text", "label": "Chronic Conditions"},
  {"fieldname": "medications", "fieldtype": "Small Text", "label": "Current Medications"},
  {"fieldname": "emergency_contact_name", "fieldtype": "Data", "label": "Emergency Contact Name"},
  {"fieldname": "emergency_contact_phone", "fieldtype": "Data", "label": "Emergency Contact Phone"},

  {"fieldname": "sen_section", "fieldtype": "Section Break", "label": "Special Educational Needs"},
  {"fieldname": "has_sen", "fieldtype": "Check", "label": "Has Special Educational Needs", "default": "0"},
  {"fieldname": "sen_notes", "fieldtype": "Small Text", "label": "SEN Notes"},

  {"fieldname": "academic_history_section", "fieldtype": "Section Break", "label": "Academic History"},
  {"fieldname": "report_cards", "fieldtype": "Table", "label": "Report Cards", "options": "Student Report Card"},

  {"fieldname": "activities_section", "fieldtype": "Section Break", "label": "Extracurricular"},
  {"fieldname": "activities", "fieldtype": "Table", "label": "Activities", "options": "Student Activity"},

  {"fieldname": "disciplinary_section", "fieldtype": "Section Break", "label": "Disciplinary Log"},
  {"fieldname": "disciplinary_records", "fieldtype": "Table", "label": "Disciplinary Records", "options": "Student Disciplinary Record"},

  {"fieldname": "transfer_section", "fieldtype": "Section Break", "label": "Transfer / Departure"},
  {"fieldname": "departure_date", "fieldtype": "Date", "label": "Departure Date"},
  {"fieldname": "destination_school", "fieldtype": "Data", "label": "Destination School"},
  {"fieldname": "transfer_reason", "fieldtype": "Small Text", "label": "Transfer Reason"},
  {"fieldname": "clearance_certificate_number", "fieldtype": "Data", "label": "Clearance Certificate Number"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1},
  {"role": "Bursar", "read": 1, "write": 1, "create": 1},
  {"role": "Fees Approver", "read": 1},
  {"role": "School Head", "read": 1},
  {"role": "District Education Auditor/Inspector", "read": 1},
  {"role": "Parent/Guardian", "read": 1},
  {"role": "Student", "read": 1}
 ]
}
