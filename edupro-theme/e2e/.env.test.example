# Copy this file to e2e/.env.test and fill in real values.
# e2e/.env.test is gitignored -- Claude never sees or types these passwords,
# only the test scripts read them via process.env.
#
# Playwright loads this automatically (see e2e/README.md for how to run).

# --- Bursar ---
E2E_BURSAR_EMAIL=bursar.demo@edupro.co.zw
E2E_BURSAR_PASSWORD=

# --- School Head ---
E2E_SCHOOL_HEAD_EMAIL=head.demo@edupro.co.zw
E2E_SCHOOL_HEAD_PASSWORD=

# --- SDC Chairperson/Treasurer ---
E2E_SDC_EMAIL=sdc.demo@edupro.co.zw
E2E_SDC_PASSWORD=

# --- System Manager (System Admin shell) ---
# Account created for this test plan -- set its password via the Frappe
# desk (https://fees.edupro.co.zw/app/user/system-admin.demo@edupro.co.zw)
# as Administrator/another System Manager: either set "New Password"
# directly on the user record, or use Frappe's "Reset Password" action to
# email yourself a reset link. No password was set at creation time.
E2E_SYSTEM_ADMIN_EMAIL=system-admin.demo@edupro.co.zw
E2E_SYSTEM_ADMIN_PASSWORD=

# --- Student ---
E2E_STUDENT_EMAIL=student.demo@edupro.co.zw
E2E_STUDENT_PASSWORD=

# --- Parent/Guardian ---
E2E_PARENT_EMAIL=parent.demo@edupro.co.zw
E2E_PARENT_PASSWORD=

# --- Fees Approver (no dashboard shell exists -- login-only check) ---
E2E_FEES_APPROVER_EMAIL=approver.demo@edupro.co.zw
E2E_FEES_APPROVER_PASSWORD=

# --- District Education Auditor/Inspector (no dashboard shell exists -- login-only check) ---
E2E_DISTRICT_AUDITOR_EMAIL=auditor.demo@edupro.co.zw
E2E_DISTRICT_AUDITOR_PASSWORD=

# --- Optional: only needed if 2FA (DEF-QA3-002) gets re-enabled before you run this ---
# E2E_BURSAR_OTP=123456
