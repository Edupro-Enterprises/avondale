---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Cashier Till Close">
	<div class="page-head">
		<h1>Cashier Till Close</h1>
		<p>Blind-count today's takings — the expected total and any variance are only calculated after you close the till.</p>
	</div>

	<div class="section">
		<h2>Fee Billing Summary</h2>
		<div class="stat-grid" id="fee-stats"></div>
	</div>

	<div id="already-closed" class="alert-band is-ok" style="display:none;"></div>

	<form id="till-form" class="card">
		<div class="section" style="margin-bottom:20px;">
			<label for="opening_float">Opening Float (USD)</label>
			<input type="number" step="0.01" id="opening_float" name="opening_float" value="0" required />
		</div>

		<h2 style="font-size:0.95rem;">Physical &amp; Digital Takings</h2>
		<div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
			<div class="field">
				<label for="usd_cash_counted">USD Cash Counted</label>
				<input type="number" step="0.01" id="usd_cash_counted" name="usd_cash_counted" value="0" required />
			</div>
			<div class="field">
				<label for="ecocash_batch_total">EcoCash Batch Total</label>
				<input type="number" step="0.01" id="ecocash_batch_total" name="ecocash_batch_total" value="0" required />
			</div>
			<div class="field">
				<label for="zig_cash_counted">ZiG Cash Counted</label>
				<input type="number" step="0.01" id="zig_cash_counted" name="zig_cash_counted" value="0" required />
			</div>
			<div class="field">
				<label for="zipit_batch_total">ZIPIT Batch Total</label>
				<input type="number" step="0.01" id="zipit_batch_total" name="zipit_batch_total" value="0" required />
			</div>
		</div>

		<button class="btn btn-primary btn-block" type="submit" id="close-btn">Close Till</button>
	</form>

	<div id="result" style="margin-top:20px;"></div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		await requireRole(['Bursar']);

		function fmt(amount, currency = 'USD') {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount);
			} catch {
				return `${currency} ${Number(amount).toFixed(2)}`;
			}
		}

		const FEE_CATEGORY_LABELS = {
			'SDC / SDA Fund': 'Levy (SDC/SDA)',
			'Tuition / General Government Fund': 'Tuition (Government)',
		};

		async function loadFeeStats() {
			const summary = await api.getOversightSummary();
			const billed = summary.billed_by_fee_category || [];
			const outstanding = summary.arrears_by_fee_category || [];

			const cards = Object.entries(FEE_CATEGORY_LABELS)
				.map(([fund, label]) => {
					const billedAmt = billed.find((r) => r.fund === fund)?.amount || 0;
					const outstandingAmt = outstanding.find((r) => r.fund === fund)?.amount || 0;
					return `
						<div class="stat-card ${outstandingAmt > 0 ? 'is-alert' : 'is-ok'}">
							<div class="value">${fmt(outstandingAmt)}</div>
							<div class="label">${label} Outstanding <br/>(${fmt(billedAmt)} billed)</div>
						</div>
					`;
				})
				.join('');

			document.getElementById('fee-stats').innerHTML = `
				<div class="stat-card ${summary.total_arrears_outstanding > 0 ? 'is-alert' : 'is-ok'}">
					<div class="value">${fmt(summary.total_arrears_outstanding)}</div>
					<div class="label">Total Outstanding</div>
				</div>
				${cards}
			`;
		}

		async function load() {
			const ctx = await api.getTillContext();
			if (ctx.already_closed) {
				document.getElementById('till-form').style.display = 'none';
				const box = document.getElementById('already-closed');
				box.style.display = 'block';
				box.innerHTML = `<strong>Till already closed for today.</strong> Reconciliation: ${ctx.existing_name}`;
			}
		}
		load();
		loadFeeStats();

		document.getElementById('till-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const btn = document.getElementById('close-btn');
			btn.disabled = true;
			btn.textContent = 'Closing till…';

			const payload = {
				opening_float: document.getElementById('opening_float').value,
				usd_cash_counted: document.getElementById('usd_cash_counted').value,
				zig_cash_counted: document.getElementById('zig_cash_counted').value,
				ecocash_batch_total: document.getElementById('ecocash_batch_total').value,
				zipit_batch_total: document.getElementById('zipit_batch_total').value,
			};

			try {
				const result = await api.closeTill(payload);
				const balanced = Math.abs(result.variance_usd) < 0.01;
				document.getElementById('result').innerHTML = `
					<div class="alert-band ${balanced ? 'is-ok' : 'is-danger'}">
						<strong>${balanced ? 'Till Balanced' : 'Variance Detected'}</strong>
						System Expected USD: ${fmt(result.system_expected_usd)}<br>
						Variance: ${fmt(result.variance_usd)}<br>
						Reconciliation: ${result.name}
					</div>
				`;
				document.getElementById('till-form').style.display = 'none';
			} catch (err) {
				document.getElementById('result').innerHTML = `<div class="alert-band is-danger"><strong>Could not close till</strong>${err.message}</div>`;
				btn.disabled = false;
				btn.textContent = 'Close Till';
			}
		});
	</script>
</PortalLayout>
