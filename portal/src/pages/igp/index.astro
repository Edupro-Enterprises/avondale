---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="IGP Counter Sales">
	<div class="page-head">
		<h1>Income-Generating Projects — Counter Sales</h1>
		<p>Issue a direct cash receipt for tuckshop, uniform shop, bus hire, or agricultural produce sales — each project keeps its own trading account.</p>
	</div>

	<div class="section" id="form-section">
		<h2>New Sale</h2>
		<div class="card">
			<div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
				<div class="field">
					<label for="f-project">Project</label>
					<select id="f-project"></select>
				</div>
				<div class="field">
					<label for="f-mode">Mode of Payment</label>
					<select id="f-mode"></select>
				</div>
				<div class="field" style="grid-column:span 2;">
					<label for="f-description">Description</label>
					<input type="text" id="f-description" placeholder="e.g. 2x exercise books, 1x juice" />
				</div>
				<div class="field">
					<label for="f-amount">Amount (USD)</label>
					<input type="number" id="f-amount" step="0.01" min="0.01" value="0" />
				</div>
			</div>
			<button type="button" class="btn btn-primary" id="save-sale-btn">Issue Receipt</button>
			<div id="sale-result" style="margin-top:14px;"></div>
		</div>
	</div>

	<div class="section">
		<h2>Project Trading Accounts — Total Revenue</h2>
		<div class="stat-grid" id="project-totals"></div>
	</div>

	<div class="section">
		<h2>Recent Sales</h2>
		<div class="card card-tight" style="overflow-x:auto;">
			<table class="portal-table" id="sales-table">
				<thead>
					<tr>
						<th>Receipt</th>
						<th>Date</th>
						<th>Project</th>
						<th>Description</th>
						<th class="text-right">Amount</th>
						<th>Cashier</th>
						<th>Print</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		const session = await requireRole(['Headmaster', 'Bursar', 'SDC Chairperson', 'Deputy Head']);
		const canSell = session.primary_role === 'Bursar';
		if (!canSell) document.getElementById('form-section').style.display = 'none';

		function fmt(amount) {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
			} catch {
				return `$${Number(amount || 0).toFixed(2)}`;
			}
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		function printUrl(name) {
			const params = new URLSearchParams({
				doctype: 'Sales Invoice',
				name,
				format: 'Enterprise Sale Receipt',
				no_letterhead: '0',
			});
			return `/printview?${params.toString()}`;
		}

		async function loadProjectTotals() {
			const totals = await api.getIgpProjectTotals();
			document.getElementById('project-totals').innerHTML = totals
				.map(
					(t) => `
						<div class="stat-card">
							<div class="value">${fmt(t.total)}</div>
							<div class="label">${esc(t.label)}</div>
						</div>
					`
				)
				.join('');
		}

		async function loadSales() {
			const rows = await api.listIgpSales();
			const body = document.querySelector('#sales-table tbody');
			if (!rows.length) {
				body.innerHTML = '<tr><td colspan="7" style="color:var(--ink-soft);">No enterprise sales recorded yet.</td></tr>';
				return;
			}
			body.innerHTML = rows
				.map(
					(r) => `
						<tr>
							<td>${esc(r.receipt_no || '')}</td>
							<td>${r.posting_date ? new Date(r.posting_date).toLocaleDateString('en-GB') : ''}</td>
							<td>${esc(r.item_code || '')}</td>
							<td>${esc(r.description || '')}</td>
							<td class="text-right tnum">${fmt(r.grand_total)}</td>
							<td style="font-size:0.78rem;">${esc(r.owner || '')}</td>
							<td><a href="${printUrl(r.name)}" target="_blank" rel="noopener">Print / PDF</a></td>
						</tr>
					`
				)
				.join('');
		}

		if (canSell) {
			document.getElementById('save-sale-btn').addEventListener('click', async () => {
				const itemCode = document.getElementById('f-project').value;
				const description = document.getElementById('f-description').value;
				const amount = document.getElementById('f-amount').value;
				const mode = document.getElementById('f-mode').value;

				if (!amount || parseFloat(amount) <= 0) return alert('Enter an amount greater than zero.');

				const btn = document.getElementById('save-sale-btn');
				btn.disabled = true;
				btn.textContent = 'Issuing…';
				try {
					const name = await api.createIgpSale(itemCode, description, amount, mode, 'HAR');
					document.getElementById('sale-result').innerHTML = `
						<div class="alert-band is-ok">
							<strong>Receipt issued: ${esc(name)}</strong>
							<a href="${printUrl(name)}" target="_blank" rel="noopener">Print / PDF</a>
						</div>
					`;
					document.getElementById('f-description').value = '';
					document.getElementById('f-amount').value = '0';
					await Promise.all([loadProjectTotals(), loadSales()]);
				} catch (err) {
					document.getElementById('sale-result').innerHTML =
						`<div class="alert-band is-danger"><strong>Could not issue receipt</strong>${esc(err.message)}</div>`;
				} finally {
					btn.disabled = false;
					btn.textContent = 'Issue Receipt';
				}
			});
		}

		async function init() {
			if (canSell) {
				const opts = await api.getIgpFormOptions();
				document.getElementById('f-project').innerHTML = opts.projects
					.map((p) => `<option value="${esc(p.item_code)}">${esc(p.label)}</option>`)
					.join('');
				document.getElementById('f-mode').innerHTML = opts.modes_of_payment
					.map((m) => `<option value="${esc(m.name)}">${esc(m.name)}</option>`)
					.join('');
			}
			await Promise.all([loadProjectTotals(), loadSales()]);
		}
		init();
	</script>
</PortalLayout>
