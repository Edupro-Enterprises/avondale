---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Oversight">
	<div class="page-head">
		<h1>Financial Oversight</h1>
		<p>Fund balances, vote-book utilisation, and outstanding fee arrears at a glance.</p>
	</div>

	<div class="section">
		<h2>Key Figures</h2>
		<div class="stat-grid" id="key-stats"></div>
	</div>

	<div class="section">
		<h2>Fund Net Surplus / (Deficit) — USD</h2>
		<div class="card card-tight" style="overflow-x:auto;">
			<table class="portal-table" id="fund-table">
				<thead><tr><th>Fund</th><th class="text-right">Balance</th></tr></thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

	<div class="section">
		<div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
			<h2 style="margin:0; border:none; padding:0;">Recent Ledger Activity</h2>
			<div style="display:flex; gap:10px;">
				<select id="fund-filter" style="width:auto;"></select>
				<select id="currency-filter" style="width:auto;">
					<option value="">All Currencies</option>
					<option value="USD">USD</option>
					<option value="ZiG">ZiG</option>
				</select>
			</div>
		</div>
		<div class="card card-tight" style="overflow-x:auto;">
			<table class="portal-table" id="ledger-table">
				<thead>
					<tr>
						<th>Date</th><th>Voucher</th><th>Account</th><th>Fund</th><th>Currency</th>
						<th class="text-right">Debit (USD)</th><th class="text-right">Credit (USD)</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		await requireRole(['Headmaster', 'SDC Chairperson']);

		function fmt(amount, currency = 'USD') {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount || 0);
			} catch {
				return `${currency} ${Number(amount || 0).toFixed(2)}`;
			}
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		const FEE_CATEGORY_LABELS = {
			'SDC / SDA Fund': 'Levy (SDC/SDA)',
			'Tuition / General Government Fund': 'Tuition (Government)',
		};

		function feeCategoryCards(byCategory) {
			return Object.entries(FEE_CATEGORY_LABELS)
				.map(([fund, label]) => {
					const row = byCategory.find((r) => r.fund === fund);
					const amount = row ? row.amount : 0;
					return `
						<div class="stat-card ${amount > 0 ? 'is-alert' : 'is-ok'}">
							<div class="value">${fmt(amount)}</div>
							<div class="label">${esc(label)} Arrears</div>
						</div>
					`;
				})
				.join('');
		}

		async function loadSummary() {
			const summary = await api.getOversightSummary();
			const vb = summary.vote_book_summary;

			document.getElementById('key-stats').innerHTML = `
				<div class="stat-card ${summary.total_arrears_outstanding > 0 ? 'is-alert' : 'is-ok'}">
					<div class="value">${fmt(summary.total_arrears_outstanding)}</div>
					<div class="label">Total Outstanding Fee Arrears</div>
				</div>
				${feeCategoryCards(summary.arrears_by_fee_category || [])}
				<div class="stat-card">
					<div class="value">${fmt(vb.approved)}</div>
					<div class="label">Vote-Book Approved</div>
				</div>
				<div class="stat-card">
					<div class="value">${fmt(vb.committed + vb.spent)}</div>
					<div class="label">Vote-Book Utilised</div>
				</div>
				<div class="stat-card ${vb.available < 0 ? 'is-alert' : 'is-ok'}">
					<div class="value">${fmt(vb.available)}</div>
					<div class="label">Vote-Book Available</div>
				</div>
			`;

			const fundBody = document.querySelector('#fund-table tbody');
			fundBody.innerHTML = summary.fund_balances
				.map((f) => `<tr><td>${esc(f.fund)}</td><td class="text-right tnum">${fmt(f.balance)}</td></tr>`)
				.join('') || '<tr><td colspan="2" style="color:var(--ink-soft);">No fund activity yet.</td></tr>';

			const fundFilter = document.getElementById('fund-filter');
			fundFilter.innerHTML =
				'<option value="">All Funds</option>' +
				summary.fund_balances.map((f) => `<option value="${esc(f.fund)}">${esc(f.fund)}</option>`).join('');
		}

		async function loadLedger() {
			const fund = document.getElementById('fund-filter').value;
			const currency = document.getElementById('currency-filter').value;
			const from_date = new Date();
			from_date.setDate(from_date.getDate() - 90);

			const data = await api.getLedgerEntries({
				from_date: from_date.toISOString().slice(0, 10),
				to_date: new Date().toISOString().slice(0, 10),
				fund,
				currency,
			});

			const body = document.querySelector('#ledger-table tbody');
			const rows = data.entries || [];
			body.innerHTML =
				rows
					.map((r) => {
						const badge =
							r.account_currency === 'USD'
								? '<span class="badge badge-black">USD</span>'
								: `<span class="badge badge-red">${esc(r.account_currency)}</span>`;
						return `
							<tr>
								<td>${new Date(r.posting_date).toLocaleDateString('en-GB')}</td>
								<td>${esc(r.voucher_no)}<br><span style="color:var(--ink-soft); font-size:0.78rem;">${esc(r.voucher_type)}</span></td>
								<td>${esc(r.account)}</td>
								<td>${esc(r.fund || '')}</td>
								<td>${badge}</td>
								<td class="text-right tnum">${r.debit ? fmt(r.debit) : ''}</td>
								<td class="text-right tnum">${r.credit ? fmt(r.credit) : ''}</td>
							</tr>
						`;
					})
					.join('') || '<tr><td colspan="7" style="color:var(--ink-soft);">No ledger entries in the last 90 days for this filter.</td></tr>';
		}

		document.getElementById('fund-filter').addEventListener('change', loadLedger);
		document.getElementById('currency-filter').addEventListener('change', loadLedger);

		loadSummary().then(loadLedger);
	</script>
</PortalLayout>
