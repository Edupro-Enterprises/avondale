---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Fee Receipting">
	<div class="page-head">
		<h1>Fee Receipting</h1>
		<p>Search a student by registration number, name, grade, or class, then take a payment against whatever they currently owe. Payments are auto-split across the correct statutory funds and receipted sequentially.</p>
	</div>

	<div class="card" id="rate-card" style="margin-bottom:24px; display:none;">
		<h2 style="font-size:0.95rem; margin-bottom:10px;">Today's Exchange Rate (ZiG → USD)</h2>
		<div id="rate-status" style="margin-bottom:10px;"></div>
		<div class="report-filters" style="margin-bottom:0;">
			<label>Rate (1 USD = ? ZiG)
				<input type="number" step="0.0001" min="0.0001" id="rate-input" placeholder="e.g. 13.5" />
			</label>
			<button class="btn btn-primary" id="rate-btn" style="align-self:flex-end;">Set Today's Rate</button>
		</div>
		<div id="rate-result" style="margin-top:10px;"></div>
	</div>

	<div class="card" style="margin-bottom:24px;">
		<div class="report-filters" style="margin-bottom:0;">
			<label>Search (Reg No. or Name)
				<input type="text" id="s-query" placeholder="e.g. EDU-STU-2026-00161 or Vhori" />
			</label>
			<label>Grade
				<select id="s-program"><option value="">All</option></select>
			</label>
			<label>Class
				<select id="s-batch"><option value="">All</option></select>
			</label>
			<button class="btn btn-primary" id="search-btn" style="align-self:flex-end;">Search</button>
		</div>
	</div>

	<div class="card card-tight" id="results-card" style="overflow-x:auto; margin-bottom:24px; display:none;">
		<table class="portal-table" id="results-table">
			<thead>
				<tr>
					<th>Student</th>
					<th>Reg No.</th>
					<th>Grade / Class</th>
					<th class="text-right">Outstanding</th>
					<th></th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<div class="card" id="account-card" style="display:none; margin-bottom:24px;">
		<h2 style="font-size:0.95rem;" id="account-title"></h2>
		<div class="stat-grid" id="account-stats" style="margin:14px 0;"></div>

		<div style="overflow-x:auto; margin-bottom:18px;">
			<table class="portal-table" id="ledger-table">
				<thead>
					<tr>
						<th>Term / Year</th>
						<th>Fund</th>
						<th>Due Date</th>
						<th class="text-right">Billed</th>
						<th class="text-right">Outstanding</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<h2 style="font-size:0.95rem; margin-bottom:12px;">Take Payment</h2>
		<form id="payment-form">
			<div class="report-filters" style="margin-bottom:0;">
				<label>Amount Tendered
					<input type="number" step="0.01" min="0.01" id="p-amount" required />
				</label>
				<label>Mode of Payment
					<select id="p-mode" required></select>
				</label>
				<label>Reference No. (batch / txn ref)
					<input type="text" id="p-reference" placeholder="e.g. EcoCash txn ID" />
				</label>
				<button class="btn btn-primary" type="submit" id="pay-btn" style="align-self:flex-end;">Receipt Payment</button>
			</div>
		</form>
		<div id="payment-result" style="margin-top:16px;"></div>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		const session = await requireRole(['Bursar']);

		function fmt(amount) {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
			} catch {
				return `$${Number(amount || 0).toFixed(2)}`;
			}
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		const FUND_LABELS = {
			'SDC / SDA Fund': 'Levy (SDC/SDA)',
			'Tuition / General Government Fund': 'Tuition (Government)',
		};

		function printUrl(name) {
			const params = new URLSearchParams({
				doctype: 'Payment Entry',
				name,
				format: 'Payment Receipt (POS)',
				no_letterhead: '0',
			});
			return `/printview?${params.toString()}`;
		}

		// ---- Today's rate ----
		async function loadRate() {
			const rate = await api.getTodayRate();
			const statusBox = document.getElementById('rate-status');
			if (rate.is_set) {
				statusBox.innerHTML = `<div class="alert-band is-ok"><strong>Rate locked for today.</strong> 1 USD = ${rate.zig_to_usd} ZiG</div>`;
			} else {
				statusBox.innerHTML = `<div class="alert-band is-danger"><strong>No rate set for today.</strong> ZiG receipting is blocked until a rate is set.</div>`;
			}
			document.getElementById('rate-card').style.display = '';
		}

		document.getElementById('rate-btn').addEventListener('click', async () => {
			const input = document.getElementById('rate-input');
			const resultBox = document.getElementById('rate-result');
			const btn = document.getElementById('rate-btn');
			if (!input.value || Number(input.value) <= 0) {
				resultBox.innerHTML = `<div class="alert-band is-danger">Enter a valid rate first.</div>`;
				return;
			}
			btn.disabled = true;
			try {
				await api.setDailyRate(input.value);
				resultBox.innerHTML = `<div class="alert-band is-ok">Rate updated.</div>`;
				input.value = '';
				loadRate();
			} catch (err) {
				resultBox.innerHTML = `<div class="alert-band is-danger">${esc(err.message)}</div>`;
			} finally {
				btn.disabled = false;
			}
		});

		// ---- Filters ----
		async function loadFormOptions() {
			const opts = await api.getReceiptingFormOptions();
			const programSel = document.getElementById('s-program');
			programSel.innerHTML =
				'<option value="">All</option>' + opts.programs.map((p) => `<option value="${esc(p.name)}">${esc(p.name)}</option>`).join('');
			const batchSel = document.getElementById('s-batch');
			batchSel.innerHTML =
				'<option value="">All</option>' + opts.student_batches.map((b) => `<option value="${esc(b.name)}">${esc(b.name)}</option>`).join('');

			const modeSel = document.getElementById('p-mode');
			modeSel.innerHTML = opts.modes_of_payment.map((m) => `<option value="${esc(m.name)}">${esc(m.name)}</option>`).join('');
		}

		// ---- Student search ----
		async function runSearch() {
			const query = document.getElementById('s-query').value;
			const program = document.getElementById('s-program').value;
			const batch = document.getElementById('s-batch').value;
			const rows = await api.searchStudentAccounts(query, program, batch);
			const card = document.getElementById('results-card');
			const body = document.querySelector('#results-table tbody');

			card.style.display = '';
			if (!rows.length) {
				body.innerHTML = '<tr><td colspan="5" style="color:var(--ink-soft);">No students match this search.</td></tr>';
				return;
			}

			body.innerHTML = rows
				.map(
					(r) => `
						<tr>
							<td>${esc(r.student_name)}</td>
							<td>${esc(r.pastel_account_code || r.student)}</td>
							<td>${esc(r.program || '')} ${esc(r.student_batch_name ? '/ ' + r.student_batch_name : '')}</td>
							<td class="text-right tnum">${fmt(r.outstanding)}</td>
							<td><button class="btn btn-secondary select-student-btn" data-student="${esc(r.student)}">Select</button></td>
						</tr>
					`
				)
				.join('');

			document.querySelectorAll('.select-student-btn').forEach((btn) =>
				btn.addEventListener('click', () => loadAccount(btn.dataset.student))
			);
		}

		document.getElementById('search-btn').addEventListener('click', runSearch);
		document.getElementById('s-query').addEventListener('keydown', (e) => {
			if (e.key === 'Enter') runSearch();
		});
		['s-program', 's-batch'].forEach((id) => document.getElementById(id).addEventListener('change', runSearch));

		// ---- Selected student account ----
		let currentStudent = null;

		async function loadAccount(student, { keepResult = false } = {}) {
			const account = await api.getStudentAccount(student);
			currentStudent = student;

			document.getElementById('account-card').style.display = '';
			document.getElementById('account-title').textContent = `${account.student_name} — ${account.pastel_account_code || account.student}`;

			document.getElementById('account-stats').innerHTML = `
				<div class="stat-card ${account.total_outstanding > 0 ? 'is-alert' : 'is-ok'}">
					<div class="value">${fmt(account.total_outstanding)}</div>
					<div class="label">Total Outstanding</div>
				</div>
				<div class="stat-card ${account.credit_balance > 0 ? 'is-ok' : ''}">
					<div class="value">${fmt(account.credit_balance)}</div>
					<div class="label">Credit / Advance Balance</div>
				</div>
			`;

			const body = document.querySelector('#ledger-table tbody');
			if (!account.outstanding_fees.length) {
				body.innerHTML = '<tr><td colspan="5" style="color:var(--ink-soft);">Nothing outstanding.</td></tr>';
			} else {
				body.innerHTML = account.outstanding_fees
					.map(
						(f) => `
							<tr>
								<td>${esc(f.academic_term || f.academic_year || '')}</td>
								<td>${esc(FUND_LABELS[f.fund] || f.fund || '')}</td>
								<td>${f.due_date ? new Date(f.due_date).toLocaleDateString('en-GB') : ''}</td>
								<td class="text-right tnum">${fmt(f.grand_total)}</td>
								<td class="text-right tnum">${fmt(f.outstanding_amount)}</td>
							</tr>
						`
					)
					.join('');
			}

			if (!keepResult) {
				document.getElementById('payment-result').innerHTML = '';
				document.getElementById('account-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			document.getElementById('p-amount').value = '';
		}

		document.getElementById('payment-form').addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!currentStudent) return;

			const btn = document.getElementById('pay-btn');
			const resultBox = document.getElementById('payment-result');
			const amount = document.getElementById('p-amount').value;
			const mode = document.getElementById('p-mode').value;
			const reference = document.getElementById('p-reference').value;

			btn.disabled = true;
			btn.textContent = 'Processing…';
			try {
				const result = await api.receiptPayment(currentStudent, amount, mode, reference, 'HAR');
				resultBox.innerHTML = `
					<div class="alert-band is-ok">
						<strong>Receipt ${esc(result.receipt_no)} issued.</strong><br>
						Tendered: ${result.tendered_currency} ${Number(result.tendered).toFixed(2)} &middot;
						Applied (USD): ${fmt(result.paid_amount_usd)} across ${result.allocated_to_fees} fee line(s)
						${result.unallocated_credit > 0 ? `&middot; New credit balance: ${fmt(result.unallocated_credit)}` : ''}
						<br><a href="${printUrl(result.payment_entry)}" target="_blank" rel="noopener">Print / PDF Receipt &rarr;</a>
					</div>
				`;
				document.getElementById('p-reference').value = '';
				loadAccount(currentStudent, { keepResult: true });
				runSearch();
			} catch (err) {
				resultBox.innerHTML = `<div class="alert-band is-danger"><strong>Could not receipt payment</strong>${esc(err.message)}</div>`;
			} finally {
				btn.disabled = false;
				btn.textContent = 'Receipt Payment';
			}
		});

		loadFormOptions();
		loadRate();
	</script>
</PortalLayout>
