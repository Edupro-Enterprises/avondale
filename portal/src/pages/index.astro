---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Edupro Portal">
	<div class="login-shell">
		<p style="color: var(--ink-soft); font-family: var(--font-mono); font-size: 0.85rem;">Loading…</p>
	</div>

	<script>
		import { api } from '../lib/api.js';

		const ROLE_LANDING = {
			Bursar: '/bursar/',
			'Deputy Head': '/auditor/',
			Headmaster: '/oversight/',
			'SDC Chairperson': '/oversight/',
		};

		api
			.getSession()
			.then((session) => {
				window.location.href = ROLE_LANDING[session.primary_role] || '/oversight/';
			})
			.catch(() => {
				window.location.href = '/login';
			});
	</script>
</BaseLayout>
