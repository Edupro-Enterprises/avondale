---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Student Fees">
	<div class="page-head">
		<h1>Student Fees</h1>
		<p>Search by class, academic year, term, student name, or student ID. Each row prints its own receipt — "View Statement" pulls up everything a student owes, combined, as one printable PDF.</p>
	</div>

	<div class="card" id="bill-term-card" style="margin-bottom:24px; display:none;">
		<h2 style="font-size:0.95rem; margin-bottom:14px;">Bill This Term</h2>
		<div class="report-filters" style="margin-bottom:14px;">
			<label>Program
				<select id="bill-program"></select>
			</label>
			<label>Academic Year
				<select id="bill-year"></select>
			</label>
			<label>Academic Term
				<select id="bill-term-select"></select>
			</label>
			<label>Due Date
				<input type="date" id="bill-due-date" />
			</label>
			<button class="btn btn-secondary" id="bill-preview-btn" style="align-self:flex-end;">Preview</button>
		</div>
		<div id="bill-preview" style="font-size:0.85rem; color:var(--ink-soft); margin-bottom:14px;"></div>
		<button class="btn btn-primary" id="bill-run-btn" disabled>Bill Term</button>
		<div id="bill-result" style="margin-top:14px;"></div>
	</div>

	<div class="card" style="margin-bottom:24px;">
		<div class="report-filters" style="margin-bottom:0;">
			<label>Class / Stream
				<select id="f-batch"><option value="">All</option></select>
			</label>
			<label>Academic Year
				<select id="f-year"><option value="">All</option></select>
			</label>
			<label>Term
				<select id="f-term"><option value="">All</option></select>
			</label>
			<label>Student Name
				<input type="text" id="f-name" placeholder="e.g. Vhori" />
			</label>
			<label>Student ID
				<input type="text" id="f-id" placeholder="e.g. EDU-STU-2026-00161" />
			</label>
			<button class="btn btn-primary" id="search-btn" style="align-self:flex-end;">Search</button>
		</div>
	</div>

	<div class="card card-tight" style="overflow-x:auto;">
		<table class="portal-table" id="fees-table">
			<thead>
				<tr>
					<th>Student</th>
					<th>Class</th>
					<th>Term / Year</th>
					<th>Fee</th>
					<th>Fund</th>
					<th>Due Date</th>
					<th class="text-right">Billed</th>
					<th class="text-right">Outstanding</th>
					<th>Status</th>
					<th>Print</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		const session = await requireRole(['Headmaster', 'Bursar', 'SDC Chairperson', 'Deputy Head']);

		function fmt(amount) {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
			} catch {
				return `$${Number(amount || 0).toFixed(2)}`;
			}
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		const FUND_LABELS = {
			'SDC / SDA Fund': 'Levy',
			'Tuition / General Government Fund': 'Tuition',
			'BEAM & Donor Restricted Fund': 'BEAM / Donor',
			'Income-Generating Projects (IGP) Fund': 'IGP',
		};

		function printUrl(name) {
			const params = new URLSearchParams({
				doctype: 'Fees',
				name,
				format: 'Fee Receipt (POS)',
				no_letterhead: '0',
			});
			return `/printview?${params.toString()}`;
		}

		function statementUrl(student, academicTerm) {
			const params = new URLSearchParams({ student });
			if (academicTerm) params.set('academic_term', academicTerm);
			return `/fees/statement/?${params.toString()}`;
		}

		async function loadFilterOptions() {
			const opts = await api.getFeesFilterOptions();
			const batchSel = document.getElementById('f-batch');
			batchSel.innerHTML =
				'<option value="">All</option>' + opts.batches.map((b) => `<option value="${esc(b.name)}">${esc(b.name)}</option>`).join('');
			const yearSel = document.getElementById('f-year');
			yearSel.innerHTML =
				'<option value="">All</option>' + opts.academic_years.map((y) => `<option value="${esc(y.name)}">${esc(y.name)}</option>`).join('');
			const termSel = document.getElementById('f-term');
			termSel.innerHTML =
				'<option value="">All</option>' +
				opts.academic_terms.map((t) => `<option value="${esc(t.name)}">${esc(t.term_name)}</option>`).join('');
		}

		async function runSearch() {
			const term = document.getElementById('f-term').value;
			const filters = {
				student_batch_name: document.getElementById('f-batch').value,
				academic_year: document.getElementById('f-year').value,
				academic_term: term,
				student_name: document.getElementById('f-name').value,
				student_id: document.getElementById('f-id').value,
			};
			const rows = await api.searchFees(filters);
			const body = document.querySelector('#fees-table tbody');

			if (!rows.length) {
				body.innerHTML = '<tr><td colspan="10" style="color:var(--ink-soft);">No fee records match this search.</td></tr>';
				return;
			}

			body.innerHTML = rows
				.map((r) => {
					const paid = r.outstanding_amount <= 0.005;
					return `
						<tr>
							<td>
								<a href="/students/profile/?student=${encodeURIComponent(r.student)}">${esc(r.student_name)}</a><br>
								<span style="color:var(--ink-soft); font-size:0.78rem;">${esc(r.student)}</span><br>
								<a href="${statementUrl(r.student, term)}" target="_blank" rel="noopener" style="font-size:0.78rem;">View Statement &rarr;</a>
							</td>
							<td>${esc(r.student_batch_name || '')}</td>
							<td>${esc(r.academic_term || r.academic_year || '')}</td>
							<td>${esc(FUND_LABELS[r.fund] || r.fee_structure)}</td>
							<td style="font-size:0.78rem;">${esc(r.fund || '')}</td>
							<td>${r.due_date ? new Date(r.due_date).toLocaleDateString('en-GB') : ''}</td>
							<td class="text-right tnum">${fmt(r.grand_total)}</td>
							<td class="text-right tnum">${fmt(r.outstanding_amount)}</td>
							<td><span class="indicator-pill ${paid ? 'ok' : 'bad'}">${paid ? 'Paid' : 'Balance Due'}</span></td>
							<td><a href="${printUrl(r.name)}" target="_blank" rel="noopener">Print / PDF</a></td>
						</tr>
					`;
				})
				.join('');
		}

		document.getElementById('search-btn').addEventListener('click', runSearch);
		['f-name', 'f-id'].forEach((id) =>
			document.getElementById(id).addEventListener('keydown', (e) => {
				if (e.key === 'Enter') runSearch();
			})
		);
		['f-batch', 'f-year', 'f-term'].forEach((id) => document.getElementById(id).addEventListener('change', runSearch));

		// ---- Bill This Term (Bursar only) ----
		async function initBillingPanel() {
			const opts = await api.getBillingOptions();
			const programSel = document.getElementById('bill-program');
			programSel.innerHTML = opts.programs.map((p) => `<option value="${esc(p.name)}">${esc(p.name)}</option>`).join('');
			const yearSel = document.getElementById('bill-year');
			yearSel.innerHTML = opts.academic_years.map((y) => `<option value="${esc(y.name)}">${esc(y.name)}</option>`).join('');
			const termSel = document.getElementById('bill-term-select');
			termSel.innerHTML = opts.academic_terms
				.map((t) => `<option value="${esc(t.name)}">${esc(t.term_name)}</option>`)
				.join('');
			document.getElementById('bill-due-date').value = new Date().toISOString().slice(0, 10);
		}

		async function previewBill() {
			const program = document.getElementById('bill-program').value;
			const year = document.getElementById('bill-year').value;
			const box = document.getElementById('bill-preview');
			const runBtn = document.getElementById('bill-run-btn');
			box.textContent = 'Loading…';
			runBtn.disabled = true;
			try {
				const p = await api.previewTermBill(program, year);
				if (!p.student_count) {
					box.textContent = `No students are enrolled in ${program} for ${year}.`;
					return;
				}
				if (!p.fee_structures.length) {
					box.textContent = `No Fee Structure is configured for ${program} in ${year}.`;
					return;
				}
				const lines = p.fee_structures.map((fs) => `${FUND_LABELS[fs.fund] || fs.fund}: ${fmt(fs.amount)}`).join(', ');
				box.innerHTML = `<strong>${p.student_count}</strong> students enrolled &middot; ${lines} &middot; <strong>${fmt(p.total_per_student)}</strong> per student. Re-running skips anyone already billed for the selected term.`;
				runBtn.disabled = false;
			} catch (err) {
				box.textContent = err.message;
			}
		}

		async function runBillTerm() {
			const program = document.getElementById('bill-program').value;
			const year = document.getElementById('bill-year').value;
			const term = document.getElementById('bill-term-select').value;
			const dueDate = document.getElementById('bill-due-date').value;
			const runBtn = document.getElementById('bill-run-btn');
			const resultBox = document.getElementById('bill-result');
			runBtn.disabled = true;
			runBtn.textContent = 'Billing…';
			try {
				const r = await api.billTerm(program, year, term, dueDate);
				resultBox.innerHTML = `<div class="alert-band is-ok"><strong>Billed ${r.billed} new Fees record(s)</strong> across ${r.students} students (${r.skipped_already_billed} already billed for this term were skipped).</div>`;
				runSearch();
			} catch (err) {
				resultBox.innerHTML = `<div class="alert-band is-danger"><strong>Could not bill term</strong>${err.message}</div>`;
			} finally {
				runBtn.disabled = false;
				runBtn.textContent = 'Bill Term';
			}
		}

		document.getElementById('bill-preview-btn').addEventListener('click', previewBill);
		document.getElementById('bill-run-btn').addEventListener('click', runBillTerm);

		loadFilterOptions().then(runSearch);

		if (session.primary_role === 'Bursar') {
			document.getElementById('bill-term-card').style.display = '';
			initBillingPanel();
		}
	</script>
</PortalLayout>
