---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Student Fees">
	<div class="page-head">
		<h1>Student Fees</h1>
		<p>Search by class, academic year, term, student name, or student ID. Each row prints its own receipt — "View Statement" pulls up everything a student owes, combined, as one printable PDF.</p>
	</div>

	<div class="card" style="margin-bottom:24px;">
		<div class="report-filters" style="margin-bottom:0;">
			<label>Class / Stream
				<select id="f-batch"><option value="">All</option></select>
			</label>
			<label>Academic Year
				<select id="f-year"><option value="">All</option></select>
			</label>
			<label>Term
				<select id="f-term"><option value="">All</option></select>
			</label>
			<label>Student Name
				<input type="text" id="f-name" placeholder="e.g. Vhori" />
			</label>
			<label>Student ID
				<input type="text" id="f-id" placeholder="e.g. EDU-STU-2026-00161" />
			</label>
			<button class="btn btn-primary" id="search-btn" style="align-self:flex-end;">Search</button>
		</div>
	</div>

	<div class="card card-tight" style="overflow-x:auto;">
		<table class="portal-table" id="fees-table">
			<thead>
				<tr>
					<th>Student</th>
					<th>Class</th>
					<th>Term / Year</th>
					<th>Fee</th>
					<th>Fund</th>
					<th>Due Date</th>
					<th class="text-right">Billed</th>
					<th class="text-right">Outstanding</th>
					<th>Status</th>
					<th>Print</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		await requireRole(['Headmaster', 'Bursar', 'SDC Chairperson', 'Deputy Head']);

		function fmt(amount) {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
			} catch {
				return `$${Number(amount || 0).toFixed(2)}`;
			}
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		const FEE_LABELS = {
			'EDU-FST-2026-00001': 'Levy',
			'EDU-FST-2026-00002': 'Tuition',
			'EDU-FST-2026-00003': 'Opening Arrears (Migrated)',
		};

		function printUrl(name) {
			const params = new URLSearchParams({
				doctype: 'Fees',
				name,
				format: 'Fee Receipt (POS)',
				no_letterhead: '0',
			});
			return `/printview?${params.toString()}`;
		}

		function statementUrl(student, academicTerm) {
			const params = new URLSearchParams({ student });
			if (academicTerm) params.set('academic_term', academicTerm);
			return `/fees/statement/?${params.toString()}`;
		}

		async function loadFilterOptions() {
			const opts = await api.getFeesFilterOptions();
			const batchSel = document.getElementById('f-batch');
			batchSel.innerHTML =
				'<option value="">All</option>' + opts.batches.map((b) => `<option value="${esc(b.name)}">${esc(b.name)}</option>`).join('');
			const yearSel = document.getElementById('f-year');
			yearSel.innerHTML =
				'<option value="">All</option>' + opts.academic_years.map((y) => `<option value="${esc(y.name)}">${esc(y.name)}</option>`).join('');
			const termSel = document.getElementById('f-term');
			termSel.innerHTML =
				'<option value="">All</option>' +
				opts.academic_terms.map((t) => `<option value="${esc(t.name)}">${esc(t.term_name)}</option>`).join('');
		}

		async function runSearch() {
			const term = document.getElementById('f-term').value;
			const filters = {
				student_batch_name: document.getElementById('f-batch').value,
				academic_year: document.getElementById('f-year').value,
				academic_term: term,
				student_name: document.getElementById('f-name').value,
				student_id: document.getElementById('f-id').value,
			};
			const rows = await api.searchFees(filters);
			const body = document.querySelector('#fees-table tbody');

			if (!rows.length) {
				body.innerHTML = '<tr><td colspan="10" style="color:var(--ink-soft);">No fee records match this search.</td></tr>';
				return;
			}

			body.innerHTML = rows
				.map((r) => {
					const paid = r.outstanding_amount <= 0.005;
					return `
						<tr>
							<td>
								${esc(r.student_name)}<br>
								<span style="color:var(--ink-soft); font-size:0.78rem;">${esc(r.student)}</span><br>
								<a href="${statementUrl(r.student, term)}" target="_blank" rel="noopener" style="font-size:0.78rem;">View Statement &rarr;</a>
							</td>
							<td>${esc(r.student_batch_name || '')}</td>
							<td>${esc(r.academic_term || r.academic_year || '')}</td>
							<td>${esc(FEE_LABELS[r.fee_structure] || r.fee_structure)}</td>
							<td style="font-size:0.78rem;">${esc(r.fund || '')}</td>
							<td>${r.due_date ? new Date(r.due_date).toLocaleDateString('en-GB') : ''}</td>
							<td class="text-right tnum">${fmt(r.grand_total)}</td>
							<td class="text-right tnum">${fmt(r.outstanding_amount)}</td>
							<td><span class="indicator-pill ${paid ? 'ok' : 'bad'}">${paid ? 'Paid' : 'Balance Due'}</span></td>
							<td><a href="${printUrl(r.name)}" target="_blank" rel="noopener">Print / PDF</a></td>
						</tr>
					`;
				})
				.join('');
		}

		document.getElementById('search-btn').addEventListener('click', runSearch);
		['f-name', 'f-id'].forEach((id) =>
			document.getElementById(id).addEventListener('keydown', (e) => {
				if (e.key === 'Enter') runSearch();
			})
		);
		['f-batch', 'f-year', 'f-term'].forEach((id) => document.getElementById(id).addEventListener('change', runSearch));

		loadFilterOptions().then(runSearch);
	</script>
</PortalLayout>
