---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Student Exemptions & Waivers">
	<div class="page-head">
		<h1>Student Exemptions &amp; Waivers</h1>
		<p>Log BEAM allocations, staff child discounts, and SDC hardship waivers. Supporting evidence must be uploaded before a record can be saved.</p>
	</div>

	<div class="section" id="form-section">
		<h2>New Exemption / Waiver</h2>
		<div class="card">
			<div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
				<div class="field" style="position:relative;">
					<label for="f-student-search">Student</label>
					<input type="text" id="f-student-search" placeholder="Type a name to search…" autocomplete="off" />
					<div id="student-results" style="position:absolute; z-index:5; background:var(--paper-raised); border:1px solid var(--line); border-radius:4px; width:100%; max-height:220px; overflow-y:auto; display:none;"></div>
					<input type="hidden" id="f-student" />
				</div>
				<div class="field">
					<label for="f-type">Exemption Type</label>
					<select id="f-type"></select>
				</div>
				<div class="field" style="grid-column:span 2;">
					<label for="f-ref">Approval Minutes Reference</label>
					<input type="text" id="f-ref" placeholder="e.g. MoPSE BEAM Award Ref 2026/07, or SDC Minutes 12 Aug 2026" />
				</div>
				<div class="field">
					<label for="f-percent">Discount Percentage</label>
					<input type="number" id="f-percent" min="0" max="100" step="1" value="0" />
				</div>
				<div class="field">
					<label for="f-amount">Amount Covered (USD)</label>
					<input type="number" id="f-amount" min="0" step="0.01" value="0" />
				</div>
				<div class="field" style="grid-column:span 2;">
					<label for="f-file">Supporting Document (BEAM award letter / SDC minutes / hardship committee approval)</label>
					<input type="file" id="f-file" accept=".pdf,.jpg,.jpeg,.png" />
					<div id="file-status" class="indicator-pill" style="margin-top:6px;">No file selected</div>
				</div>
			</div>
			<button type="button" class="btn btn-primary" id="save-btn" disabled>Save Exemption</button>
			<div id="save-result" style="margin-top:14px;"></div>
		</div>
	</div>

	<div class="section">
		<h2>Exemptions &amp; Waivers on Record</h2>
		<div class="card card-tight" style="overflow-x:auto;">
			<table class="portal-table" id="exemptions-table">
				<thead>
					<tr>
						<th>Student</th>
						<th>Type</th>
						<th>Approval Ref</th>
						<th class="text-right">Discount %</th>
						<th class="text-right">Amount Covered</th>
						<th>Status</th>
						<th>Evidence</th>
						<th>Print</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		const session = await requireRole(['Headmaster', 'Bursar', 'SDC Chairperson', 'Deputy Head']);
		const canCreate = session.primary_role === 'Bursar';
		if (!canCreate) document.getElementById('form-section').style.display = 'none';

		function fmt(amount) {
			try {
				return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
			} catch {
				return `$${Number(amount || 0).toFixed(2)}`;
			}
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		function printUrl(name) {
			const params = new URLSearchParams({
				doctype: 'Student Exemption and Discount',
				name,
				format: 'Student Exemption Voucher',
				no_letterhead: '0',
			});
			return `/printview?${params.toString()}`;
		}

		let uploadedFileUrl = null;

		function checkReady() {
			const student = document.getElementById('f-student').value;
			const ref = document.getElementById('f-ref').value.trim();
			document.getElementById('save-btn').disabled = !(student && ref && uploadedFileUrl);
		}

		if (canCreate) {
			const searchInput = document.getElementById('f-student-search');
			const resultsBox = document.getElementById('student-results');
			let searchTimer;
			searchInput.addEventListener('input', () => {
				clearTimeout(searchTimer);
				document.getElementById('f-student').value = '';
				checkReady();
				const q = searchInput.value.trim();
				if (!q) {
					resultsBox.style.display = 'none';
					return;
				}
				searchTimer = setTimeout(async () => {
					const rows = await api.searchStudents(q);
					if (!rows.length) {
						resultsBox.innerHTML = '<div style="padding:8px; color:var(--ink-soft);">No matches.</div>';
					} else {
						resultsBox.innerHTML = rows
							.map(
								(r) =>
									`<div class="student-result" data-id="${esc(r.name)}" data-name="${esc(r.student_name)}" style="padding:8px; cursor:pointer; border-bottom:1px solid var(--line);">${esc(r.student_name)} <span style="color:var(--ink-soft); font-size:0.78rem;">${esc(r.name)}</span></div>`
							)
							.join('');
					}
					resultsBox.style.display = 'block';
				}, 250);
			});
			resultsBox.addEventListener('click', (e) => {
				const row = e.target.closest('.student-result');
				if (!row) return;
				document.getElementById('f-student').value = row.dataset.id;
				searchInput.value = row.dataset.name;
				resultsBox.style.display = 'none';
				checkReady();
			});
			document.getElementById('f-ref').addEventListener('input', checkReady);

			document.getElementById('f-file').addEventListener('change', async (e) => {
				const file = e.target.files[0];
				const statusEl = document.getElementById('file-status');
				if (!file) {
					uploadedFileUrl = null;
					statusEl.textContent = 'No file selected';
					statusEl.className = 'indicator-pill';
					checkReady();
					return;
				}
				statusEl.textContent = 'Uploading…';
				statusEl.className = 'indicator-pill';
				try {
					const result = await api.uploadFile(file, null, null);
					uploadedFileUrl = result.file_url;
					statusEl.textContent = `Attached: ${file.name}`;
					statusEl.className = 'indicator-pill ok';
				} catch (err) {
					uploadedFileUrl = null;
					statusEl.textContent = 'Upload failed';
					statusEl.className = 'indicator-pill bad';
					alert(err.message);
				}
				checkReady();
			});

			document.getElementById('save-btn').addEventListener('click', async () => {
				const btn = document.getElementById('save-btn');
				btn.disabled = true;
				btn.textContent = 'Saving…';
				try {
					const name = await api.createExemption({
						student: document.getElementById('f-student').value,
						exemption_type: document.getElementById('f-type').value,
						approval_minutes_ref: document.getElementById('f-ref').value,
						supporting_document: uploadedFileUrl,
						discount_percentage: document.getElementById('f-percent').value,
						amount_covered: document.getElementById('f-amount').value,
					});
					document.getElementById('save-result').innerHTML = `
						<div class="alert-band is-ok">
							<strong>Saved: ${esc(name)}</strong>
							<a href="${printUrl(name)}" target="_blank" rel="noopener">Print / PDF</a>
						</div>
					`;
					document.getElementById('f-student-search').value = '';
					document.getElementById('f-student').value = '';
					document.getElementById('f-ref').value = '';
					document.getElementById('f-percent').value = '0';
					document.getElementById('f-amount').value = '0';
					document.getElementById('f-file').value = '';
					document.getElementById('file-status').textContent = 'No file selected';
					document.getElementById('file-status').className = 'indicator-pill';
					uploadedFileUrl = null;
					await loadExemptions();
				} catch (err) {
					document.getElementById('save-result').innerHTML =
						`<div class="alert-band is-danger"><strong>Could not save</strong>${esc(err.message)}</div>`;
				} finally {
					btn.textContent = 'Save Exemption';
					checkReady();
				}
			});
		}

		async function loadExemptions() {
			const rows = await api.listExemptions();
			const body = document.querySelector('#exemptions-table tbody');
			if (!rows.length) {
				body.innerHTML = '<tr><td colspan="8" style="color:var(--ink-soft);">No exemptions on record.</td></tr>';
				return;
			}
			body.innerHTML = rows
				.map((r) => {
					const statusLabel = r.docstatus === 1 ? 'Submitted' : r.docstatus === 2 ? 'Cancelled' : 'Draft';
					return `
						<tr>
							<td><a href="/students/profile/?student=${encodeURIComponent(r.student)}">${esc(r.student_name)}</a><br><span style="color:var(--ink-soft); font-size:0.78rem;">${esc(r.student)}</span></td>
							<td>${esc(r.exemption_type)}</td>
							<td>${esc(r.approval_minutes_ref || '')}</td>
							<td class="text-right tnum">${r.discount_percentage || 0}%</td>
							<td class="text-right tnum">${fmt(r.amount_covered)}</td>
							<td><span class="indicator-pill ${r.docstatus === 1 ? 'ok' : ''}">${statusLabel}</span></td>
							<td>${r.supporting_document ? `<a href="${esc(r.supporting_document)}" target="_blank" rel="noopener">View</a>` : '—'}</td>
							<td><a href="${printUrl(r.name)}" target="_blank" rel="noopener">Print / PDF</a></td>
						</tr>
					`;
				})
				.join('');
		}

		async function init() {
			if (canCreate) {
				const opts = await api.getExemptionFormOptions();
				document.getElementById('f-type').innerHTML = opts.exemption_types
					.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`)
					.join('');
			}
			await loadExemptions();
		}
		init();
	</script>
</PortalLayout>
