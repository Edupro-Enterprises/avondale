---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Student Profile">
	<div class="page-head">
		<h1 id="profile-name">Loading…</h1>
		<p id="profile-subtitle" style="color:var(--ink-soft);"></p>
	</div>

	<!-- Print-only letterhead, same pattern as the statutory reports / statement pages -->
	<div class="print-letterhead">
		<img src="/avondale-crest.png" alt="Avondale Primary School" />
		<div>
			<p class="school-name">AVONDALE PRIMARY SCHOOL</p>
			<div class="school-meta">Ministry of Primary and Secondary Education (MoPSE) Registered Institution</div>
			<div class="school-meta">27 Corner King George Rd &amp; Aberdeen Rd, Harare, Zimbabwe | Tel: +263 242 335 443</div>
			<div class="school-meta" id="print-profile-title" style="margin-top:6px; font-weight:700;"></div>
		</div>
	</div>

	<div class="section no-print" style="display:flex; gap:10px; align-items:center;">
		<a href="/fees/" class="btn btn-secondary">&larr; Back</a>
		<button class="btn btn-secondary" id="edit-btn" style="display:none;">Edit Profile</button>
		<button class="btn btn-primary" id="save-btn" style="display:none;">Save Changes</button>
		<button class="btn btn-secondary" id="cancel-btn" style="display:none;">Cancel</button>
		<button class="btn btn-primary btn-print" id="print-btn" style="margin-left:auto;">🖨 Print / Save as PDF</button>
	</div>

	<div id="loading" style="color:var(--ink-soft); font-size:0.88rem;">Loading…</div>

	<div id="profile-body" style="display:none;">
		<div class="card section" style="display:flex; gap:24px; align-items:flex-start; flex-wrap:wrap;">
			<div>
				<img id="profile-photo" src="/logo.png" alt="Student photo" width="140" height="140"
					style="width:140px; height:140px; object-fit:cover; border-radius:8px; border:1px solid var(--line); background:var(--paper-sunk);" />
				<div class="no-print" id="photo-upload-wrap" style="display:none; margin-top:10px;">
					<input type="file" id="photo-input" accept="image/*" style="font-size:0.78rem;" />
				</div>
			</div>
			<div style="flex:1; min-width:220px;">
				<div class="stat-grid">
					<div class="stat-card">
						<div class="value" id="stat-class" style="font-size:1.1rem;">N/A</div>
						<div class="label">Class</div>
					</div>
					<div class="stat-card">
						<div class="value" id="stat-id" style="font-size:1.1rem;">N/A</div>
						<div class="label">Student ID</div>
					</div>
					<div class="stat-card">
						<div class="value" id="stat-pastel" style="font-size:1.1rem;">N/A</div>
						<div class="label">Pastel Code</div>
					</div>
				</div>
			</div>
		</div>

		<div class="section">
			<h2>Personal Details</h2>
			<div class="card" id="personal-view"></div>
			<div class="card" id="personal-edit" style="display:none;"></div>
		</div>

		<div class="section">
			<h2>Address</h2>
			<div class="card" id="address-view"></div>
			<div class="card" id="address-edit" style="display:none;"></div>
		</div>

		<div class="section">
			<h2>Parent / Guardian Details</h2>
			<div class="card" id="guardians-view"></div>
			<div class="card" id="guardians-edit" style="display:none;"></div>
		</div>

		<div class="section">
			<h2>Health &amp; Emergency Contact</h2>
			<div class="card" id="health-view"></div>
			<div class="card" id="health-edit" style="display:none;"></div>
		</div>

		<div class="section">
			<h2>Sports &amp; Clubs</h2>
			<div class="card" id="sports-view"></div>
			<div class="card" id="sports-edit" style="display:none;"></div>
		</div>

		<div class="section">
			<h2>Academic Notes</h2>
			<div class="card" id="academics-view"></div>
			<div class="card" id="academics-edit" style="display:none;"></div>
		</div>

		<div class="section no-print" id="logs-section" style="display:none;">
			<h2>Recent Log Entries</h2>
			<div class="card card-tight" style="overflow-x:auto;">
				<table class="portal-table" id="logs-table">
					<thead><tr><th>Date</th><th>Type</th><th>Note</th></tr></thead>
					<tbody></tbody>
				</table>
			</div>
		</div>
	</div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		const session = await requireRole(['Headmaster', 'Bursar', 'SDC Chairperson', 'Deputy Head']);
		const canEdit = session.primary_role === 'Bursar';

		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}
		function na(v) {
			return v === null || v === undefined || v === '' ? 'N/A' : esc(v);
		}
		function fmtDate(d) {
			return d ? new Date(d).toLocaleDateString('en-GB') : 'N/A';
		}

		const params = new URLSearchParams(window.location.search);
		const student = params.get('student');
		let profile = null;

		if (!student) {
			document.getElementById('loading').textContent = 'No student specified.';
		} else {
			await load();
		}

		async function load() {
			profile = await api.getStudentProfile(student);
			document.getElementById('loading').style.display = 'none';
			document.getElementById('profile-body').style.display = '';

			document.title = `${profile.student_name} — Edupro`;
			document.getElementById('profile-name').textContent = profile.student_name || 'N/A';
			document.getElementById('profile-subtitle').textContent = `${profile.name} — ${profile.program || 'N/A'}`;
			document.getElementById('print-profile-title').textContent = `Student Profile — ${profile.student_name} (${profile.name})`;

			document.getElementById('profile-photo').src = profile.image || '/logo.png';
			document.getElementById('stat-class').textContent = na(profile.student_batch_name);
			document.getElementById('stat-id').textContent = na(profile.name);
			document.getElementById('stat-pastel').textContent = na(profile.pastel_account_code);

			renderPersonalView();
			renderAddressView();
			renderGuardiansView();
			renderHealthView();
			renderSportsView();
			renderAcademicsView();
			renderLogs();

			if (canEdit) {
				document.getElementById('edit-btn').style.display = '';
			}
		}

		function row(label, value) {
			return `<div style="margin-bottom:10px;"><label style="margin-bottom:2px;">${esc(label)}</label><div>${value}</div></div>`;
		}
		function twoCol(html) {
			return `<div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">${html}</div>`;
		}

		function renderPersonalView() {
			document.getElementById('personal-view').innerHTML = twoCol(
				row('Date of Birth', fmtDate(profile.date_of_birth)) +
					row('Gender', na(profile.gender)) +
					row('Blood Group', na(profile.blood_group)) +
					row('Nationality', na(profile.nationality)) +
					row('Mobile Number', na(profile.student_mobile_number)) +
					row('Email', na(profile.student_email_id))
			);
		}

		function renderAddressView() {
			document.getElementById('address-view').innerHTML = twoCol(
				row('Address Line 1', na(profile.address_line_1)) +
					row('Address Line 2', na(profile.address_line_2)) +
					row('City', na(profile.city)) +
					row('State', na(profile.state)) +
					row('Pincode', na(profile.pincode)) +
					row('Country', na(profile.country))
			);
		}

		function renderGuardiansView() {
			const box = document.getElementById('guardians-view');
			if (!profile.guardians || !profile.guardians.length) {
				box.innerHTML = '<p style="color:var(--ink-soft);">N/A — no guardian on record.</p>';
				return;
			}
			box.innerHTML = profile.guardians
				.map(
					(g) => `
					<div style="padding:12px 0; border-bottom:1px solid var(--line);">
						<strong>${na(g.relation)}</strong>: ${na(g.guardian_name)}<br>
						<span style="color:var(--ink-soft); font-size:0.85rem;">
							${na(g.mobile_number)} &middot; ${na(g.email_address)} &middot; ${na(g.occupation)}
						</span>
					</div>
				`
				)
				.join('');
		}

		function renderHealthView() {
			document.getElementById('health-view').innerHTML = twoCol(
				row('Emergency Contact Name', na(profile.emergency_contact_name)) +
					row('Emergency Contact Phone', na(profile.emergency_contact_phone)) +
					row('Allergies', na(profile.allergies)) +
					row('Medical Conditions', na(profile.medical_conditions))
			);
		}

		function renderSportsView() {
			document.getElementById('sports-view').innerHTML = row('', na(profile.sports_and_clubs));
		}

		function renderAcademicsView() {
			document.getElementById('academics-view').innerHTML = row('', na(profile.academic_notes));
		}

		function renderLogs() {
			if (!profile.logs || !profile.logs.length) return;
			document.getElementById('logs-section').style.display = '';
			document.querySelector('#logs-table tbody').innerHTML = profile.logs
				.map((l) => `<tr><td>${fmtDate(l.date)}</td><td>${esc(l.type)}</td><td>${esc(l.log || '')}</td></tr>`)
				.join('');
		}

		// ---- Edit mode ----
		function field(id, label, value, type = 'text') {
			return `<div class="field"><label for="${id}">${esc(label)}</label><input type="${type}" id="${id}" value="${esc(value ?? '')}" /></div>`;
		}
		function textareaField(id, label, value) {
			return `<div class="field"><label for="${id}">${esc(label)}</label><textarea id="${id}" rows="3" style="width:100%; padding:12px 14px; border:1px solid var(--line); border-radius:4px; background:var(--paper-raised); color:var(--ink); font-size:0.95rem; font-family:inherit;">${esc(value ?? '')}</textarea></div>`;
		}
		function selectField(id, label, value, options) {
			const opts =
				'<option value=""></option>' +
				options.map((o) => `<option value="${esc(o)}" ${o === value ? 'selected' : ''}>${esc(o)}</option>`).join('');
			return `<div class="field"><label for="${id}">${esc(label)}</label><select id="${id}">${opts}</select></div>`;
		}

		let formOptions = null;

		function enterEditMode() {
			document.getElementById('personal-edit').innerHTML = twoCol(
				field('e-dob', 'Date of Birth', profile.date_of_birth, 'date') +
					selectField('e-gender', 'Gender', profile.gender, formOptions.genders) +
					field('e-blood', 'Blood Group', profile.blood_group) +
					field('e-nationality', 'Nationality', profile.nationality) +
					field('e-mobile', 'Mobile Number', profile.student_mobile_number) +
					field('e-email', 'Email', profile.student_email_id, 'email')
			);
			document.getElementById('address-edit').innerHTML = twoCol(
				field('e-addr1', 'Address Line 1', profile.address_line_1) +
					field('e-addr2', 'Address Line 2', profile.address_line_2) +
					field('e-city', 'City', profile.city) +
					field('e-state', 'State', profile.state) +
					field('e-pincode', 'Pincode', profile.pincode) +
					selectField('e-country', 'Country', profile.country, formOptions.countries)
			);

			const mother = profile.guardians.find((g) => g.relation === 'Mother') || {};
			const father = profile.guardians.find((g) => g.relation === 'Father') || {};
			document.getElementById('guardians-edit').innerHTML = `
				<h3 style="font-size:0.85rem; margin-bottom:10px;">Mother</h3>
				${twoCol(
					field('e-mother-name', 'Name', mother.guardian_name) +
						field('e-mother-phone', 'Phone', mother.mobile_number) +
						field('e-mother-email', 'Email', mother.email_address, 'email') +
						field('e-mother-occupation', 'Occupation', mother.occupation)
				)}
				<h3 style="font-size:0.85rem; margin:16px 0 10px;">Father</h3>
				${twoCol(
					field('e-father-name', 'Name', father.guardian_name) +
						field('e-father-phone', 'Phone', father.mobile_number) +
						field('e-father-email', 'Email', father.email_address, 'email') +
						field('e-father-occupation', 'Occupation', father.occupation)
				)}
			`;

			document.getElementById('health-edit').innerHTML = twoCol(
				field('e-ec-name', 'Emergency Contact Name', profile.emergency_contact_name) +
					field('e-ec-phone', 'Emergency Contact Phone', profile.emergency_contact_phone)
			) + textareaField('e-allergies', 'Allergies', profile.allergies) + textareaField('e-conditions', 'Medical Conditions', profile.medical_conditions);

			document.getElementById('sports-edit').innerHTML = textareaField('e-sports', '', profile.sports_and_clubs);
			document.getElementById('academics-edit').innerHTML = textareaField('e-academics', '', profile.academic_notes);

			['personal', 'address', 'guardians', 'health', 'sports', 'academics'].forEach((s) => {
				document.getElementById(`${s}-view`).style.display = 'none';
				document.getElementById(`${s}-edit`).style.display = '';
			});
			document.getElementById('photo-upload-wrap').style.display = '';
			document.getElementById('edit-btn').style.display = 'none';
			document.getElementById('save-btn').style.display = '';
			document.getElementById('cancel-btn').style.display = '';
		}

		function exitEditMode() {
			['personal', 'address', 'guardians', 'health', 'sports', 'academics'].forEach((s) => {
				document.getElementById(`${s}-view`).style.display = '';
				document.getElementById(`${s}-edit`).style.display = 'none';
			});
			document.getElementById('photo-upload-wrap').style.display = 'none';
			document.getElementById('edit-btn').style.display = '';
			document.getElementById('save-btn').style.display = 'none';
			document.getElementById('cancel-btn').style.display = 'none';
		}

		async function saveChanges() {
			const saveBtn = document.getElementById('save-btn');
			saveBtn.disabled = true;
			saveBtn.textContent = 'Saving…';
			try {
				const v = (id) => document.getElementById(id).value;
				await api.updateStudentProfile(student, {
					date_of_birth: v('e-dob'),
					gender: v('e-gender'),
					blood_group: v('e-blood'),
					nationality: v('e-nationality'),
					student_mobile_number: v('e-mobile'),
					student_email_id: v('e-email'),
					address_line_1: v('e-addr1'),
					address_line_2: v('e-addr2'),
					city: v('e-city'),
					state: v('e-state'),
					pincode: v('e-pincode'),
					country: v('e-country'),
					emergency_contact_name: v('e-ec-name'),
					emergency_contact_phone: v('e-ec-phone'),
					allergies: v('e-allergies'),
					medical_conditions: v('e-conditions'),
					sports_and_clubs: v('e-sports'),
					academic_notes: v('e-academics'),
				});

				if (v('e-mother-name')) {
					const mother = profile.guardians.find((g) => g.relation === 'Mother') || {};
					await api.upsertGuardian({
						student,
						relation: 'Mother',
						guardian: mother.guardian,
						guardian_name: v('e-mother-name'),
						mobile_number: v('e-mother-phone'),
						email_address: v('e-mother-email'),
						occupation: v('e-mother-occupation'),
					});
				}
				if (v('e-father-name')) {
					const father = profile.guardians.find((g) => g.relation === 'Father') || {};
					await api.upsertGuardian({
						student,
						relation: 'Father',
						guardian: father.guardian,
						guardian_name: v('e-father-name'),
						mobile_number: v('e-father-phone'),
						email_address: v('e-father-email'),
						occupation: v('e-father-occupation'),
					});
				}

				const photoInput = document.getElementById('photo-input');
				if (photoInput.files && photoInput.files[0]) {
					const uploaded = await api.uploadFile(photoInput.files[0], 'Student', student);
					await api.updateStudentPhoto(student, uploaded.file_url);
				}

				await load();
				exitEditMode();
			} catch (err) {
				alert(err.message);
			} finally {
				saveBtn.disabled = false;
				saveBtn.textContent = 'Save Changes';
			}
		}

		document.getElementById('edit-btn').addEventListener('click', async () => {
			if (!formOptions) formOptions = await api.getProfileFormOptions();
			enterEditMode();
		});
		document.getElementById('cancel-btn').addEventListener('click', exitEditMode);
		document.getElementById('save-btn').addEventListener('click', saveChanges);
		document.getElementById('print-btn').addEventListener('click', () => window.print());
	</script>
</PortalLayout>
