---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Auditor Exception Dashboard">
	<div class="page-head">
		<h1>Auditor Exception Dashboard</h1>
		<p>Real-time alerts for cancelled receipts, direct manual cash entries, backdated vouchers, unreconciled tills, and receipt sequence gaps.</p>
	</div>

	<div class="field" style="max-width:220px;">
		<label for="days">Lookback</label>
		<select id="days">
			<option value="7">Last 7 days</option>
			<option value="30" selected>Last 30 days</option>
			<option value="90">Last 90 days</option>
			<option value="180">Last 180 days</option>
		</select>
	</div>

	<div class="stat-grid section" id="summary"></div>
	<div id="sections"></div>

	<script>
		import { api, requireRole } from '../../lib/api.js';

		await requireRole(['Deputy Head']);

		const SECTIONS = [
			{
				key: 'cancelled_receipts',
				title: 'Cancelled Receipts',
				empty: 'No cancelled receipts in this period.',
				columns: [
					{ label: 'Receipt', field: 'name' },
					{ label: 'Student', field: 'student_name' },
					{ label: 'Amount', field: 'grand_total', currency: true },
					{ label: 'Cancelled By', field: 'owner' },
					{ label: 'Cancelled On', field: 'modified', date: true },
				],
			},
			{
				key: 'manual_cash_entries',
				title: 'Direct Manual GL Entries to Cash',
				empty: 'No direct manual journal entries to a cash account in this period.',
				columns: [
					{ label: 'Journal Entry', field: 'name' },
					{ label: 'Posting Date', field: 'posting_date', date: true },
					{ label: 'Amount', field: 'total_debit', currency: true },
					{ label: 'Remark', field: 'user_remark' },
					{ label: 'Created By', field: 'owner' },
				],
			},
			{
				key: 'backdated_vouchers',
				title: 'Backdated Vouchers',
				empty: 'No backdated vouchers in this period.',
				columns: [
					{ label: 'Voucher', field: 'name' },
					{ label: 'Type', field: 'doctype' },
					{ label: 'Posting Date', field: 'posting_date', date: true },
					{ label: 'Created On', field: 'creation', date: true },
					{ label: 'Created By', field: 'owner' },
				],
			},
			{
				key: 'unreconciled_till_balances',
				title: 'Un-Reconciled Till Balances',
				empty: 'No till reconciliations with a variance in this period.',
				columns: [
					{ label: 'Reconciliation', field: 'name' },
					{ label: 'Cashier', field: 'cashier_user' },
					{ label: 'Date', field: 'reconciliation_date', date: true },
					{ label: 'Variance (USD)', field: 'variance_usd', currency: true },
				],
			},
			{
				key: 'receipt_sequence_gaps',
				title: 'Receipt Sequence Gaps',
				empty: 'No gaps in the sequential receipt numbering — all clear.',
				columns: [
					{ label: 'Missing Receipt No', field: 'missing_receipt_no' },
					{ label: 'Terminal', field: 'terminal' },
					{ label: 'Year', field: 'year' },
				],
			},
		];

		function fmt(amount) {
			return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
		}
		function fmtDate(d) {
			if (!d) return '';
			return new Date(d).toLocaleDateString('en-GB');
		}
		function esc(s) {
			const div = document.createElement('div');
			div.textContent = s ?? '';
			return div.innerHTML;
		}

		async function load() {
			const days = document.getElementById('days').value;
			const data = await api.getExceptions(days);

			const summaryEl = document.getElementById('summary');
			summaryEl.innerHTML = SECTIONS.map((s) => {
				const count = (data[s.key] || []).length;
				return `
					<div class="stat-card ${count > 0 ? 'is-alert' : 'is-ok'}">
						<div class="value">${count}</div>
						<div class="label">${s.title}</div>
					</div>
				`;
			}).join('');

			const sectionsEl = document.getElementById('sections');
			sectionsEl.innerHTML = SECTIONS.map((s) => {
				const rows = data[s.key] || [];
				if (!rows.length) {
					return `<div class="section"><h2>${s.title}</h2><p style="color:var(--ink-soft);">${s.empty}</p></div>`;
				}
				const head = s.columns.map((c) => `<th>${c.label}</th>`).join('');
				const body = rows
					.map((row) => {
						const cells = s.columns
							.map((c) => {
								let v = row[c.field];
								if (c.currency) v = fmt(v);
								else if (c.date && v) v = fmtDate(v);
								else v = esc(v);
								return `<td${c.currency ? ' class="text-right tnum"' : ''}>${v}</td>`;
							})
							.join('');
						return `<tr>${cells}</tr>`;
					})
					.join('');
				return `
					<div class="section">
						<h2>${s.title}</h2>
						<div class="card card-tight" style="overflow-x:auto;">
							<table class="portal-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>
						</div>
					</div>
				`;
			}).join('');
		}

		document.getElementById('days').addEventListener('change', load);
		load();
	</script>
</PortalLayout>
