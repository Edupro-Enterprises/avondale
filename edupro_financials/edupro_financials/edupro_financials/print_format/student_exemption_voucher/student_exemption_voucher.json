 "html": "<style>\n\t.print-format table, .print-format tr,\n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 145%;\n\t\tvertical-align: middle;\n\t}\n\t.voucher-title {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tfont-size: 15px;\n\t\tletter-spacing: 1px;\n\t\tmargin: 8px 0 14px;\n\t\tborder-top: 2px solid #000;\n\t\tborder-bottom: 2px solid #000;\n\t\tpadding: 6px 0;\n\t}\n\t.voucher-meta td { padding: 3px 0; font-size: 12px; }\n\t.sig-row { margin-top: 30px; }\n\t.sig-line { border-top: 1px solid #000; margin-top: 40px; padding-top: 4px; font-size: 11px; }\n</style>\n{% if letter_head %}{{ letter_head }}{% endif %}\n\n<div class=\"voucher-title\">STUDENT EXEMPTION &amp; DISCOUNT VOUCHER</div>\n\n<table class=\"voucher-meta\" style=\"width: 100%;\">\n\t<tr>\n\t\t<td style=\"width: 50%;\"><b>{{ _(\"Voucher No\") }}:</b> {{ doc.name }}</td>\n\t\t<td><b>{{ _(\"Status\") }}:</b> {{ _(\"Submitted\") if doc.docstatus == 1 else _(\"Draft\") }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Student\") }}:</b> {{ doc.student }}</td>\n\t\t<td><b>{{ _(\"Exemption Type\") }}:</b> {{ doc.exemption_type }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Approval Minutes Ref\") }}:</b> {{ doc.approval_minutes_ref }}</td>\n\t\t<td></td>\n\t</tr>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<tbody>\n\t\t<tr><td>{{ _(\"Discount Percentage\") }}</td><td class=\"text-right\">{{ doc.discount_percentage or 0 }}%</td></tr>\n\t\t<tr><td>{{ _(\"Amount Covered\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"amount_covered\") }}</td></tr>\n\t</tbody>\n</table>\n\n<p style=\"margin-top:14px; font-size:11px; color:#555;\">\n\t{{ _(\"This voucher is issued under the school's committee-approved exemption policy and is tied to the minutes reference above. A supporting document is mandatorily attached to this record (spec section 4.1).\") }}\n</p>\n\n<div class=\"sig-row\" style=\"display:flex; gap: 40px;\">\n\t<div style=\"flex:1;\"><div class=\"sig-line\">{{ _(\"Bursar\") }}</div></div>\n\t<div style=\"flex:1;\"><div class=\"sig-line\">{{ _(\"Headmaster\") }}</div></div>\n</div>\n",
