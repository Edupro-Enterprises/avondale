  "doctype": "Print Format",
  "font": null,
  "font_size": 0,
  "format_data": null,
  "html": "<style>\n\t.print-format table, .print-format tr,\n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 145%;\n\t\tvertical-align: middle;\n\t}\n\t.voucher-title {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tfont-size: 15px;\n\t\tletter-spacing: 1px;\n\t\tmargin: 8px 0 14px;\n\t\tborder-top: 2px solid #000;\n\t\tborder-bottom: 2px solid #000;\n\t\tpadding: 6px 0;\n\t}\n\t.voucher-meta td { padding: 3px 0; font-size: 12px; }\n\t.sig-row { margin-top: 30px; }\n\t.sig-line { border-top: 1px solid #000; margin-top: 40px; padding-top: 4px; font-size: 11px; }\n</style>\n{% if letter_head %}{{ letter_head }}{% endif %}\n\n<div class=\"voucher-title\">PURCHASE ORDER VOUCHER</div>\n\n<table class=\"voucher-meta\" style=\"width: 100%;\">\n\t<tr>\n\t\t<td style=\"width: 50%;\"><b>{{ _(\"PO No\") }}:</b> {{ doc.name }}</td>\n\t\t<td><b>{{ _(\"Date\") }}:</b> {{ doc.get_formatted(\"transaction_date\") }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Supplier\") }}:</b> {{ doc.supplier_name or doc.supplier }}</td>\n\t\t<td><b>{{ _(\"Funding Category\") }}:</b> {{ doc.get(\"funding_category\") or \"—\" }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Fiscal Year\") }}:</b> {{ doc.get(\"fiscal_year\") or \"—\" }}</td>\n\t\t<td><b>{{ _(\"Status\") }}:</b> {{ _(\"Submitted\") if doc.docstatus == 1 else _(\"Draft\") }}</td>\n\t</tr>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th>{{ _(\"Item\") }}</th>\n\t\t\t<th>{{ _(\"Expense Account\") }}</th>\n\t\t\t<th class=\"text-right\">{{ _(\"Qty\") }}</th>\n\t\t\t<th class=\"text-right\">{{ _(\"Amount\") }}</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t{%- for item in doc.items -%}\n\t\t<tr>\n\t\t\t<td>{{ item.item_name or item.item_code }}</td>\n\t\t\t<td>{{ item.expense_account or \"—\" }}</td>\n\t\t\t<td class=\"text-right\">{{ item.qty }}</td>\n\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"amount\", doc) }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n\t<tfoot>\n\t\t<tr style=\"font-weight:700;\">\n\t\t\t<td colspan=\"3\" class=\"text-right\">{{ _(\"Grand Total\") }}</td>\n\t\t\t<td class=\"text-right\">{{ doc.get_formatted(\"grand_total\") }}</td>\n\t\t</tr>\n\t</tfoot>\n</table>\n\n<p style=\"margin-top:14px; font-size: 11px; color: #555;\">\n\t{{ _(\"This voucher confirms each line item was checked against its Vote-Book Allocation available balance before submission (see spec section 5.2) — a request exceeding the available balance is blocked automatically and cannot reach this printed stage.\") }}\n</p>\n\n<h4 style=\"font-size: 12px; margin: 16px 0 4px;\">{{ _(\"Procurement Compliance Checklist\") }}</h4>\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>{{ _(\"3 Competitive Vendor Quotations Attached\") }}</td>\n\t\t\t<td class=\"text-right\">{{ \"✓\" if doc.get(\"quotations_attached\") else \"✗\" }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>{{ _(\"Comparative Schedule Attached\") }}</td>\n\t\t\t<td class=\"text-right\">{{ \"✓\" if doc.get(\"comparative_schedule_attached\") else \"✗\" }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>{{ _(\"Supplier Proforma Invoice Attached\") }}</td>\n\t\t\t<td class=\"text-right\">{{ \"✓\" if doc.get(\"proforma_invoice_attached\") else \"✗\" }}</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div class=\"sig-row\" style=\"display:flex; gap: 30px; flex-wrap: wrap;\">\n\t<div style=\"flex:1; min-width:180px;\">\n\t\t<div class=\"sig-line\">{{ _(\"Bursar (Draft)\") }}</div>\n\t</div>\n\t<div style=\"flex:1; min-width:180px;\">\n\t\t<div class=\"sig-line\">{{ _(\"Deputy Head / Accountant (Verify)\") }}</div>\n\t</div>\n\t<div style=\"flex:1; min-width:180px;\">\n\t\t<div class=\"sig-line\">{{ _(\"Headmaster (Approve)\") }}</div>\n\t</div>\n\t<div style=\"flex:1; min-width:180px;\">\n\t\t<div class=\"sig-line\">{{ _(\"SDC Chairperson (Approve)\") }}</div>\n\t</div>\n</div>\n",
