\"flex:1;\"><div class=\"sig-line\">{{ _(\"Bursar\") }}</div></div>\n\t<div style=\"flex:1;\"><div class=\"sig-line\">{{ _(\"Headmaster\") }}</div></div>\n</div>\n",
