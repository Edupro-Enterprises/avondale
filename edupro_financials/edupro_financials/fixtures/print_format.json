  "html": "<style>\n\t.print-format table, .print-format tr,\n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 145%;\n\t\tvertical-align: middle;\n\t}\n\t.voucher-title {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tfont-size: 15px;\n\t\tletter-spacing: 1px;\n\t\tmargin: 8px 0 14px;\n\t\tborder-top: 2px solid #000;\n\t\tborder-bottom: 2px solid #000;\n\t\tpadding: 6px 0;\n\t}\n\t.voucher-meta td { padding: 3px 0; font-size: 12px; }\n\t.sig-row { margin-top: 30px; }\n\t.sig-line { border-top: 1px solid #000; margin-top: 40px; padding-top: 4px; font-size: 11px; }\n</style>\n{% if letter_head %}{{ letter_head }}{% endif %}\n\n<div class=\"voucher-title\">DAILY CASHIER TILL RECONCILIATION &amp; CLOSE-OUT SHEET</div>\n\n<table class=\"voucher-meta\" style=\"width: 100%;\">\n\t<tr>\n\t\t<td style=\"width: 50%;\"><b>{{ _(\"Cashier\") }}:</b> {{ doc.cashier_user }}</td>\n\t\t<td><b>{{ _(\"Terminal\") }}:</b> {{ doc.get(\"terminal\") or \"HAR\" }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Reconciliation Date\") }}:</b> {{ doc.get_formatted(\"reconciliation_date\") }}</td>\n\t\t<td><b>{{ _(\"Status\") }}:</b> {{ _(\"Submitted\") if doc.docstatus == 1 else _(\"Draft\") }}</td>\n\t</tr>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<thead>\n\t\t<tr><th>{{ _(\"Item\") }}</th><th class=\"text-right\">{{ _(\"Amount\") }}</th></tr>\n\t</thead>\n\t<tbody>\n\t\t<tr><td>{{ _(\"Opening Float (USD)\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"opening_float\") }}</td></tr>\n\t</tbody>\n</table>\n\n<p style=\"margin: 14px 0 6px;\"><b>{{ _(\"Physical &amp; Digital Takings (Blind Count)\") }}</b></p>\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<tbody>\n\t\t<tr><td>{{ _(\"USD Cash Counted\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"usd_cash_counted\") }}</td></tr>\n\t\t<tr><td>{{ _(\"ZiG Cash Counted\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"zig_cash_counted\") }}</td></tr>\n\t\t<tr><td>{{ _(\"EcoCash Batch Total\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"ecocash_batch_total\") }}</td></tr>\n\t\t<tr><td>{{ _(\"ZIPIT Batch Total\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"zipit_batch_total\") }}</td></tr>\n\t</tbody>\n</table>\n\n<p style=\"margin: 14px 0 6px;\"><b>{{ _(\"System Reconciliation (computed on submit)\") }}</b></p>\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<tbody>\n\t\t<tr><td>{{ _(\"System Expected USD\") }}</td><td class=\"text-right\">{{ doc.get_formatted(\"system_expected_usd\") }}</td></tr>\n\t\t<tr>\n\t\t\t<td><b>{{ _(\"Variance (USD)\") }}</b></td>\n\t\t\t<td class=\"text-right\"><b>{{ doc.get_formatted(\"variance_usd\") }}</b></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n{% if doc.variance_usd and doc.variance_usd != 0 %}\n\t<p style=\"text-align:center; font-weight:700; border:1px solid #000; padding:6px; margin-top:14px;\">{{ _(\"VARIANCE DETECTED — REQUIRES BURSAR / HEADMASTER REVIEW\") }}</p>\n{% else %}\n\t<p style=\"text-align:center; font-weight:700; border:1px solid #000; padding:6px; margin-top:14px;\">{{ _(\"TILL BALANCED\") }}</p>\n{% endif %}\n\n<div class=\"sig-row\" style=\"display:flex; gap: 40px;\">\n\t<div style=\"flex:1;\">\n\t\t{% if doc.bursar_signature %}<img src=\"{{ doc.bursar_signature }}\" style=\"height:50px;\">{% endif %}\n\t\t<div class=\"sig-line\">{{ _(\"Bursar Signature\") }}</div>\n\t</div>\n\t<div style=\"flex:1;\">\n\t\t<div class=\"sig-line\">{{ _(\"Headmaster / Reviewer Signature\") }}</div>\n\t</div>\n</div>\n",
