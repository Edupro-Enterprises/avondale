  "format_data": null,
  "html": "<style>\n\t.print-format table, .print-format tr,\n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 145%;\n\t\tvertical-align: middle;\n\t}\n\t.receipt-title {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tfont-size: 14px;\n\t\tletter-spacing: 1px;\n\t\tmargin: 6px 0 10px;\n\t\tborder-top: 1px dashed #000;\n\t\tborder-bottom: 1px dashed #000;\n\t\tpadding: 4px 0;\n\t}\n\t.receipt-meta td { padding: 1px 0; font-size: 12px; }\n\t.receipt-status {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tmargin-top: 6px;\n\t\tpadding: 4px;\n\t\tborder: 1px solid #000;\n\t}\n\t@media screen {\n\t\t.print-format { width: 3.2in; padding: 0.2in; min-height: 6in; }\n\t}\n\t@media print {\n\t\t.print-format { width: 100%; }\n\t}\n</style>\n\n{% if letter_head %}{{ letter_head }}{% endif %}\n\n<div class=\"receipt-title\">ENTERPRISE SALE RECEIPT</div>\n\n<table class=\"receipt-meta\" style=\"width: 100%;\">\n\t<tr>\n\t\t<td><b>{{ _(\"Receipt No\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.receipt_no or _(\"(pending submission)\") }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Date\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.get_formatted(\"posting_date\") }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Fund\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.get(\"fund\") or \"\" }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Cashier\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.owner }}</td>\n\t</tr>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th style=\"width: 60%;\">{{ _(\"Item\") }}</th>\n\t\t\t<th style=\"width: 40%;\" class=\"text-right\">{{ _(\"Amount\") }}</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t{%- for row in doc.items -%}\n\t\t<tr>\n\t\t\t<td>{{ row.description or row.item_name }}</td>\n\t\t\t<td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed no-border\" style=\"width: 100%;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 65%;\"><b>{{ _(\"Grand Total\") }}</b></td>\n\t\t\t<td class=\"text-right\">{{ doc.get_formatted(\"grand_total\") }}</td>\n\t\t</tr>\n\t\t{%- for pmt in doc.payments -%}\n\t\t<tr>\n\t\t\t<td class=\"text-right\">{{ pmt.mode_of_payment }}</td>\n\t\t\t<td class=\"text-right\">{{ pmt.get_formatted(\"amount\", doc) }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n\n<div class=\"receipt-status\">{{ _(\"PAID IN FULL\") }}</div>\n\n<p style=\"text-align: center; font-size: 11px; margin-top: 14px;\">\n\t{{ _(\"This receipt is proof of payment. Please retain for your records.\") }}<br>\n\t{{ _(\"No refunds or amendments without the original receipt.\") }}\n</p>\n<p class=\"text-center\" style=\"font-size: 11px;\">{{ _(\"Thank you.\") }}</p>\n",
