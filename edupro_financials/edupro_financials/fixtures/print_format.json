  "html": "<style>\n\t.print-format table, .print-format tr,\n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 145%;\n\t\tvertical-align: middle;\n\t}\n\t.receipt-title {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tfont-size: 14px;\n\t\tletter-spacing: 1px;\n\t\tmargin: 6px 0 10px;\n\t\tborder-top: 1px dashed #000;\n\t\tborder-bottom: 1px dashed #000;\n\t\tpadding: 4px 0;\n\t}\n\t.receipt-meta td {\n\t\tpadding: 1px 0;\n\t\tfont-size: 12px;\n\t}\n\t.receipt-status {\n\t\ttext-align: center;\n\t\tfont-weight: 700;\n\t\tmargin-top: 6px;\n\t\tpadding: 4px;\n\t\tborder: 1px solid #000;\n\t}\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 3.2in;\n\t\t\tpadding: 0.2in;\n\t\t\tmin-height: 6in;\n\t\t}\n\t}\n\t@media print {\n\t\t.print-format {\n\t\t\twidth: 100%;\n\t\t}\n\t}\n</style>\n\n{% if letter_head %}\n\t{{ letter_head }}\n{% endif %}\n\n<div class=\"receipt-title\">OFFICIAL RECEIPT</div>\n\n<table class=\"receipt-meta\" style=\"width: 100%;\">\n\t<tr>\n\t\t<td><b>{{ _(\"Receipt No\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.receipt_no or _(\"(pending submission)\") }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Date\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.get_formatted(\"posting_date\") }} {{ doc.posting_time or \"\" }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Student\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.student_name }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Academic Year\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.academic_year or \"\" }}</td>\n\t</tr>\n\t<tr>\n\t\t<td><b>{{ _(\"Cashier\") }}:</b></td>\n\t\t<td class=\"text-right\">{{ doc.owner }}</td>\n\t</tr>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed\" style=\"width: 100%;\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th style=\"width: 40%;\">{{ _(\"Fee Component\") }}</th>\n\t\t\t<th style=\"width: 30%;\">{{ _(\"Fund\") }}</th>\n\t\t\t<th style=\"width: 30%;\" class=\"text-right\">{{ _(\"Amount\") }}</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t{%- for row in doc.combined_components -%}\n\t\t<tr>\n\t\t\t<td>{{ row.fees_category }}</td>\n\t\t\t<td style=\"font-size: 10px;\">{{ row.fund or \"\" }}</td>\n\t\t\t<td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n\n<hr>\n\n<table class=\"table table-condensed no-border\" style=\"width: 100%;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 65%;\"><b>{{ _(\"Grand Total\") }}</b></td>\n\t\t\t<td class=\"text-right\">{{ doc.combined_grand_total_formatted }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"text-right\" style=\"width: 65%;\">{{ _(\"Outstanding Balance\") }}</td>\n\t\t\t<td class=\"text-right\">{{ doc.combined_outstanding_formatted }}</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n{% if doc.combined_outstanding and doc.combined_outstanding > 0 %}\n\t<div class=\"receipt-status\">{{ _(\"BALANCE DUE\") }}</div>\n{% else %}\n\t<div class=\"receipt-status\">{{ _(\"PAID IN FULL\") }}</div>\n{% endif %}\n\n<p style=\"text-align: center; font-size: 11px; margin-top: 14px;\">\n\t{{ _(\"This receipt is proof of payment. Please retain for your records.\") }}<br>\n\t{{ _(\"No refunds or amendments without the original receipt.\") }}\n</p>\n<p class=\"text-center\" style=\"font-size: 11px;\">{{ _(\"Thank you.\") }}</p>\n",
